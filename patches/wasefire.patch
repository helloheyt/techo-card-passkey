+// Links the vendored static archives (see vendor/README.md for provenance).
+fn main() {
+    let dir = std::path::PathBuf::from(std::env::var("CARGO_MANIFEST_DIR").unwrap()).join("vendor/lib");
+    println!("cargo:rustc-link-search=native={}", dir.display());
+    println!("cargo:rustc-link-lib=static=nfc_t4t");
+    println!("cargo:rustc-link-lib=static=nrfx_nfct");
+    println!("cargo:rerun-if-changed=vendor/lib/libnfc_t4t.a");
+    println!("cargo:rerun-if-changed=vendor/lib/libnrfx_nfct.a");
+}
diff --git a/crates/runner-nordic/crates/nrf-nfc/src/lib.rs b/crates/runner-nordic/crates/nrf-nfc/src/lib.rs
new file mode 100644
index 0000000..a49f8c9
--- /dev/null
+++ b/crates/runner-nordic/crates/nrf-nfc/src/lib.rs
@@ -0,0 +1,639 @@
+//! nRF52840 NFC Type 4 Tag (raw ISO-DEP) stack for the LilyGO T-Echo Card port of OpenSK.
+//!
+//! Thin FFI over two static archives built or downloaded by the installer (see `vendor/README.md`):
+//! - `libnrfx_nfct.a`: Nordic's nrfx NFCT driver (BSD-3-Clause) (+ TIMER0 workaround timer),
+//! - `libnfc_t4t.a`: Nordic's Type 4 Tag library (ISO 14443-4: RATS/ATS, I-block chaining, WTX).
+//!
+//! Plus the C-ABI platform hooks those archives call back into, adapted from solokeys/solo2
+//! `components/nrf-nfc` (MIT). Both archives use packed (`-fshort-enums`) enums, so every enum
+//! crossing the boundary is a `u8` here.
+//!
+//! Assumptions: HFXO is started by the runner at boot and stays on, so a detected field is
+//! activated synchronously; NFCT and TIMER0 interrupts are routed to [`irq_nfct`] and
+//! [`irq_timer0`] by the runner.
+
+#![no_std]
+
+use core::ffi::c_void;
+
+/// `nfc_t4t_event_t` values.
+pub mod event {
+    pub const FIELD_ON: u8 = 1;
+    pub const FIELD_OFF: u8 = 2;
+    pub const DATA_TRANSMITTED: u8 = 5;
+    pub const DATA_IND: u8 = 6;
+}
+
+/// `NFC_T4T_DI_FLAG_MORE`: more fragments of the same APDU follow.
+pub const DI_FLAG_MORE: u32 = 0x01;
+
+/// Application callback: `(context, event, data, data_length, flags)`.
+pub type Callback = unsafe extern "C" fn(*mut c_void, u8, *const u8, usize, u32);
+
+unsafe extern "C" {
+    fn nfc_t4t_setup(callback: Callback, context: *mut c_void) -> i32;
+    fn nfc_t4t_emulation_start() -> i32;
+    fn nfc_t4t_emulation_stop() -> i32;
+    fn nfc_t4t_response_pdu_send(pdu: *const u8, pdu_length: usize) -> i32;
+    fn nfc_t4t_parameter_set(id: u8, data: *const core::ffi::c_void, data_length: usize) -> i32;
+    fn nrfx_nfct_irq_handler();
+    fn nrfx_nfct_rx_impl(desc: *const DataDesc) -> i32;
+    fn nrfx_nfct_tx_impl(desc: *const DataDesc, delay_mode: u8) -> i32;
+    fn nrfx_nfct_workaround_timer_handler();
+    fn nrfx_nfct_state_force(state: u8);
+}
+
+/// Bring-up diagnostics: [OR of nrfx event ids seen by the platform handler, number of
+/// ACTIVATE forces, number of deferred callbacks, NFCTAGSTATE right after the last force,
+/// number of failed buffer allocations].
+pub static DIAG: [core::sync::atomic::AtomicU32; 7] = [const { core::sync::atomic::AtomicU32::new(0) }; 7];
+
+/// Optional bring-up hook `(index, value)` installed by the runner to persist diagnostics.
+pub static mut MARK: Option<fn(usize, u32)> = None;
+
+fn mark(index: usize, value: u32) {
+    if let Some(f) = unsafe { MARK } {
+        f(index, value);
+    }
+}
+
+fn reg(addr: usize) -> u32 {
+    unsafe { (addr as *const u32).read_volatile() }
+}
+
+fn diag_or(i: usize, v: u32) {
+    DIAG[i].fetch_or(v, core::sync::atomic::Ordering::Relaxed);
+}
+
+fn diag_inc(i: usize) {
+    DIAG[i].fetch_add(1, core::sync::atomic::Ordering::Relaxed);
+}
+
+/// `nrfx_nfct_data_desc_t`.
+#[repr(C)]
+pub struct DataDesc {
+    pub data_size: u32,
+    pub p_data: *const u8,
+}
+
+// ── Bring-up trace: (tag, a, b, cycle counter) entries, flushed by the runner ─────────────────
+
+pub const TRACE_ENTRIES: usize = 1024; // RAM ring; persisted by appending to the flash log
+pub static TRACE: [core::sync::atomic::AtomicU32; 4 * TRACE_ENTRIES] =
+    [const { core::sync::atomic::AtomicU32::new(0) }; 4 * TRACE_ENTRIES];
+pub static TRACE_LEN: core::sync::atomic::AtomicUsize = core::sync::atomic::AtomicUsize::new(0);
+
+pub mod tag {
+    pub const IRQ_BEFORE: u32 = 1;
+    pub const IRQ_AFTER: u32 = 2;
+    pub const RX_CALL: u32 = 3;
+    pub const RX_RET: u32 = 4;
+    pub const TX_CALL: u32 = 5;
+    pub const TX_RET: u32 = 6;
+    pub const PLATFORM_EVT: u32 = 7;
+    pub const CB_REQUEST: u32 = 8;
+    pub const APP_EVT: u32 = 9;
+    pub const TIMER0: u32 = 10;
+}
+
+fn cycles() -> u32 {
+    unsafe { (0xE000_1004 as *const u32).read_volatile() } // DWT->CYCCNT
+}
+
+fn enable_cycle_counter() {
+    unsafe {
+        let demcr = 0xE000_EDFC as *mut u32;
+        demcr.write_volatile(demcr.read_volatile() | (1 << 24)); // TRCENA
+        let ctrl = 0xE000_1000 as *mut u32;
+        ctrl.write_volatile(ctrl.read_volatile() | 1); // CYCCNTENA
+    }
+}
+
+/// Low-level (per-frame / per-interrupt) tracing; off: only APDU-level events are kept so the
+/// ring holds a whole CTAP exchange.
+pub static VERBOSE: core::sync::atomic::AtomicBool = core::sync::atomic::AtomicBool::new(false);
+
+fn vtrace(tag: u32, a: u32, b: u32) {
+    if VERBOSE.load(core::sync::atomic::Ordering::Relaxed) {
+        trace(tag, a, b);
+    }
+}
+
+/// Appends a trace entry (ring buffer: keeps the last TRACE_ENTRIES entries).
+pub fn trace(tag: u32, a: u32, b: u32) {
+    use core::sync::atomic::Ordering::Relaxed;
+    let i = TRACE_LEN.fetch_add(1, Relaxed) % TRACE_ENTRIES;
+    TRACE[4 * i].store(tag, Relaxed);
+    TRACE[4 * i + 1].store(a, Relaxed);
+    TRACE[4 * i + 2].store(b, Relaxed);
+    TRACE[4 * i + 3].store(cycles(), Relaxed);
+}
+
+/// Persists the RAM trace through the runner hook (blocks ~40 us per word: never call it while a
+/// reader is talking to us).
+pub fn flush_trace() {
+    use core::sync::atomic::Ordering::Relaxed;
+    let total = TRACE_LEN.load(Relaxed);
+    let n = total.min(TRACE_ENTRIES);
+    mark(0xFE, 0x7E00_0000 | n as u32);
+    mark(0x6B, total as u32); // total entries ever (older ones were overwritten)
+    for (i, d) in DIAG.iter().enumerate() {
+        mark(0x60 + i, d.load(Relaxed));
+    }
+    mark(0x67, reg(0x4000_5410)); // NFCTAGSTATE now
+    mark(0x68, reg(0x4000_5304)); // NFCT INTEN now
+    mark(0x69, reg(0x4000_543C)); // FIELDPRESENT now
+    mark(0x6A, reg(0xE000_E100)); // NVIC ISER0 now
+    flush_log();
+}
+
+/// Flash log (flight recorder): 0xE0000..0xE9000 (free in the dongle layout, inside the UF2 app
+/// space). Erased by the runner on its first flush of a boot (so the previous session's log
+/// survives reboots without NFC activity); marker 0x6E records that this boot wrote it.
+const LOG_START: usize = 0x000E_0000;
+const LOG_END: usize = 0x000E_9000;
+static LOG_FLUSHED: core::sync::atomic::AtomicUsize = core::sync::atomic::AtomicUsize::new(0);
+
+fn nvmc_write(addr: usize, value: u32) {
+    unsafe {
+        let ready = 0x4001_E400 as *const u32;
+        let config = 0x4001_E504 as *mut u32;
+        if (addr as *const u32).read_volatile() != 0xFFFF_FFFF {
+            return;
+        }
+        while ready.read_volatile() == 0 {}
+        config.write_volatile(1);
+        while ready.read_volatile() == 0 {}
+        (addr as *mut u32).write_volatile(value);
+        while ready.read_volatile() == 0 {}
+        config.write_volatile(0);
+        while ready.read_volatile() == 0 {}
+    }
+}
+
+fn nvmc_erase(page: usize) {
+    unsafe {
+        let ready = 0x4001_E400 as *const u32;
+        let config = 0x4001_E504 as *mut u32;
+        while ready.read_volatile() == 0 {}
+        config.write_volatile(2);
+        while ready.read_volatile() == 0 {}
+        (0x4001_E508 as *mut u32).write_volatile(page as u32); // ERASEPAGE
+        while ready.read_volatile() == 0 {}
+        config.write_volatile(0);
+        while ready.read_volatile() == 0 {}
+    }
+}
+
+/// Appends the trace entries recorded since the last call to the flash log (stalls the CPU about
+/// 160 us per entry: never call it while a reader is in the field).
+pub fn flush_log() {
+    use core::sync::atomic::Ordering::Relaxed;
+    let total = TRACE_LEN.load(Relaxed);
+    static ERASED: core::sync::atomic::AtomicBool = core::sync::atomic::AtomicBool::new(false);
+    if !ERASED.swap(true, Relaxed) {
+        let mut page = LOG_START;
+        while page < LOG_END {
+            nvmc_erase(page);
+            page += 0x1000;
+        }
+        mark(0x6E, 0x10C);
+    }
+    let mut from = LOG_FLUSHED.load(Relaxed);
+    if total - from > TRACE_ENTRIES {
+        from = total - TRACE_ENTRIES; // overwritten in RAM: record the gap
+        let pos = LOG_START + 16 * LOG_FLUSHED.load(Relaxed).min((LOG_END - LOG_START) / 16);
+        let _ = pos;
+    }
+    for k in from .. total {
+        let addr = LOG_START + 16 * k;
+        if addr + 16 > LOG_END {
+            break;
+        }
+        let slot = k % TRACE_ENTRIES;
+        for w in 0 .. 4 {
+            nvmc_write(addr + 4 * w, TRACE[4 * slot + w].load(Relaxed));
+        }
+    }
+    LOG_FLUSHED.store(total, Relaxed);
+}
+
+#[unsafe(no_mangle)]
+extern "C" fn nrfx_nfct_rx(desc: *const DataDesc) -> i32 {
+    let d = unsafe { &*desc };
+    if d.data_size < 16 {
+        trace(tag::RX_CALL, d.data_size, d.p_data as u32); // short RX (S(WTX) reply)
+    } else {
+        vtrace(tag::RX_CALL, d.data_size, d.p_data as u32);
+    }
+    // After our own frame the TXFRAMEEND->ENABLERXDATA shortcut has already armed the RX into our
+    // TX buffer (MAXLEN 257). Re-arming here (ENABLERXDATA) hits the reader's answer mid-frame
+    // whenever the interrupt is late, turning it into garbage (CRC error, size 509/8190, seen
+    // after chained I-blocks on iPhone and Android). So when the NFCT is already receiving into
+    // our buffer, only enable the RX interrupts as nrfx would; the frame is copied into the
+    // library's buffer when it ends (see `nfc_platform_event_handler`).
+    use core::sync::atomic::Ordering::Relaxed;
+    LIB_RX_PTR.store(d.p_data as u32, Relaxed);
+    LIB_RX_LEN.store(d.data_size, Relaxed);
+    let rx_inten = RX_INTEN.load(Relaxed);
+    let short = unsafe { core::ptr::addr_of!(SHORT_TX.0) as u32 };
+    let pp = reg(0x4000_5510); // PACKETPTR
+    if rx_inten != 0 && reg(0x4000_5410) == 4 && pp >= short && pp < short + 2 * SHORT_TX_LEN as u32 {
+        unsafe { (0x4000_5304 as *mut u32).write_volatile(rx_inten) }; // INTENSET
+        trace(0xF6, d.data_size, pp); // RX left armed by the shortcut
+        return 0;
+    }
+    let ret = unsafe { nrfx_nfct_rx_impl(desc) };
+    if ret == 0 {
+        RX_INTEN.store(reg(0x4000_5300) & (1 << 5 | 1 << 6), Relaxed); // INTEN: RXFRAMESTART/END
+    }
+    // The NFCT stores the 2 CRC bytes in RAM and counts them against MAXLEN, but the library arms
+    // the RX for an S(WTX) reply with exactly 2 bytes -> the reply (f2 10 + CRC) is received with
+    // OVERRUN and dropped (seen on iPhone, nfc44: rx_status=0x8 size=2). Leave room for the CRC
+    // when the buffer is ours and has it.
+    if ret == 0 && !d.p_data.is_null() {
+        let buf = unsafe { core::ptr::addr_of_mut!(T4T_BUF.0) as usize };
+        let ptr = d.p_data as usize;
+        let want = d.data_size as usize + 2;
+        if ptr >= buf && ptr + want <= buf + 2 * T4T_BUFFER_SIZE + 128 && want <= 257 {
+            unsafe { (0x4000_5514 as *mut u32).write_volatile(want as u32) }; // MAXLEN
+        }
+    }
+    vtrace(tag::RX_RET, ret as u32, reg(0x4000_5514));
+    ret
+}
+
+#[unsafe(no_mangle)]
+extern "C" fn nrfx_nfct_tx(desc: *const DataDesc, delay_mode: u8) -> i32 {
+    let d = unsafe { &*desc };
+    let first = if d.p_data.is_null() { 0 } else { unsafe { (d.p_data as *const u32).read_unaligned() } };
+    trace(tag::TX_CALL, d.data_size | (delay_mode as u32) << 24, first);
+    // MAXLEN is shared by TX and RX: nrfx sets it to the TX size. The reader answers short frames
+    // (S(WTX) -> f2 10 + CRC) right away, and if the library has not re-armed its RX buffer yet the
+    // answer lands in the TX buffer with MAXLEN 2 -> OVERRUN -> dropped -> the library later answers
+    // the reader's R(NAK) with a stale I-block and the phone deselects (seen on iPhone, nfc40).
+    // The library's WTX buffer is its own static, so send short frames from our buffer instead and
+    // leave 64 bytes of room; nrfx reports the actual buffer pointer with the received frame.
+    // Hardware shortcut TXFRAMEEND -> ENABLERXDATA: the reader answers within ~100 us of our
+    // frame, but the library only arms the RX (ENABLERXDATA) from the TXFRAMEEND interrupt, which
+    // is late while OpenSK computes (seen on iPhone, nfc46: TXS/TXE/RXS/RXE all pending in one
+    // interrupt, reply received with OVERRUN = no RX buffer armed). With the shortcut the reply is
+    // stored at PACKETPTR (our TX buffer, MAXLEN set below) and nrfx reports that pointer.
+    // Re-applied on every TX because nrfx may power-cycle the NFCT (errata 141).
+    unsafe { (0x4000_5200 as *mut u32).write_volatile(reg(0x4000_5200) | 1 << 5) }; // SHORTS
+    // Every frame is sent from our own double buffer, so a reply that the shortcut stores at
+    // PACKETPTR never overwrites the library's copy of its last block (needed for R(NAK) resends).
+    let ret = if !d.p_data.is_null() && d.data_size as usize <= SHORT_TX_LEN {
+        unsafe {
+            // Alternate between two buffers so a frame still being sent is never overwritten.
+            static NEXT: core::sync::atomic::AtomicUsize = core::sync::atomic::AtomicUsize::new(0);
+            let i = NEXT.fetch_xor(1, core::sync::atomic::Ordering::Relaxed) & 1;
+            let short = (core::ptr::addr_of_mut!(SHORT_TX.0) as *mut u8).add(i * SHORT_TX_LEN);
+            core::ptr::copy_nonoverlapping(d.p_data, short, d.data_size as usize);
+            let local = DataDesc { data_size: d.data_size, p_data: short };
+            let ret = nrfx_nfct_tx_impl(&local, delay_mode);
+            if ret == 0 {
+                (0x4000_5514 as *mut u32).write_volatile(257); // MAXLEN (hardware maximum)
+            }
+            ret
+        }
+    } else {
+        unsafe { nrfx_nfct_tx_impl(desc, delay_mode) }
+    };
+    if ret != 0 {
+        trace(tag::TX_RET, ret as u32, d.data_size);
+    } else {
+        vtrace(tag::TX_RET, ret as u32, 0);
+    }
+    ret
+}
+
+/// Error code returned by the Nordic library (negative errno).
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub struct NfcError(pub i32);
+
+fn check(code: i32) -> Result<(), NfcError> {
+    if code == 0 { Ok(()) } else { Err(NfcError(code)) }
+}
+
+/// Registers the event callback (raw ISO-DEP mode). Must be called once before [`start`].
+///
+/// # Safety
+///
+/// The callback runs in the NFCT interrupt and must be safe to call from there.
+pub unsafe fn setup(callback: Callback) -> Result<(), NfcError> {
+    enable_cycle_counter();
+    trace(0xEE, 0x5E7, 0); // sanity entry: proves the trace path works
+    // No errata-57 analog pokes: they are nRF52832 engineering-A only (MDK system_nrf52.c) and
+    // nrfx applies nothing like it on the nRF52840. Power-cycle NFCT instead (as embassy-nrf does)
+    // to drop any state left by the bootloaders.
+    unsafe {
+        let power = 0x4000_5FFC as *mut u32;
+        power.write_volatile(0);
+        let _ = power.read_volatile();
+        power.write_volatile(1);
+    }
+    // Errata-57-style analog tuning of the NFCT load modulation, as the solo2 nRF52840 runner does
+    // (Nordic documents it for the nRF52832 only). The phone NAKs/loses our responses without it.
+    unsafe {
+        mark(0x9A, (0x4000_5610 as *const u32).read_volatile());
+        mark(0x9B, (0x4000_5614 as *const u32).read_volatile());
+        mark(0x9C, (0x4000_5618 as *const u32).read_volatile());
+        mark(0x9D, (0x4000_5688 as *const u32).read_volatile());
+        (0x4000_5004 as *mut u32).write_volatile(1); // NFCT TASKS_DISABLE
+        cortex_m::asm::delay(150);
+        (0x4000_5610 as *mut u32).write_volatile(0x0000_0005);
+        (0x4000_5614 as *mut u32).write_volatile(0x0000_003F);
+        (0x4000_5618 as *mut u32).write_volatile(0x0000_0000);
+        (0x4000_5688 as *mut u32).write_volatile(0x0000_0001);
+    }
+    // Interrupt priorities: everything defaults to 0, so NFCT could never preempt USBD/RTC/...
+    // Move all interrupts to priority 1; libnfc_t4t sets NFCT back to 0 below, TIMER0 (the NFCT
+    // errata-190 workaround timer) is set to 0 here.
+    unsafe {
+        let ipr = 0xE000_E400 as *mut u8;
+        // NFCT/TIMER0 at 1 (highest used), everything else at 2.
+        for n in 0 .. 48 {
+            ipr.add(n).write_volatile(2 << 5);
+        }
+        ipr.add(5).write_volatile(1 << 5); // NFCT
+        ipr.add(8).write_volatile(1 << 5); // TIMER0
+    }
+    check(unsafe { nfc_t4t_setup(callback, core::ptr::null_mut()) })?;
+    // 4-byte (single size) NFCID1, as in the solo2 runner: passing just the length selects a
+    // default-derived NFCID1 of that size.
+    const NFC_T4T_PARAM_NFCID1: u8 = 3;
+    let len: u8 = 4;
+    let _ = unsafe { nfc_t4t_parameter_set(NFC_T4T_PARAM_NFCID1, &len as *const u8 as *const _, 1) };
+    Ok(())
+}
+
+/// Sets the Frame Waiting time Integer advertised in the ATS (FWT = 256 * 16 / fc * 2^FWI;
+/// FWI 8 = about 77 ms per frame, the maximum allowed by NFC Forum). Call before [`start`].
+pub fn set_fwi(fwi: u8) -> Result<(), NfcError> {
+    const NFC_T4T_PARAM_FWI: u8 = 0;
+    check(unsafe { nfc_t4t_parameter_set(NFC_T4T_PARAM_FWI, &fwi as *const u8 as *const _, 1) })
+}
+
+/// Starts tag emulation (the NFCT peripheral starts sensing for a reader field).
+pub fn start() -> Result<(), NfcError> {
+    let r = unsafe { nfc_t4t_emulation_start() };
+    trace(0xE1, r as u32, reg(0x4000_5410) | reg(0x4000_5304) << 8);
+    check(r)
+}
+
+/// Stops tag emulation and powers the NFCT peripheral down.
+pub fn stop() -> Result<(), NfcError> {
+    let r = unsafe { nfc_t4t_emulation_stop() };
+    trace(0xE2, r as u32, 0);
+    check(r)
+}
+
+/// Sends a response PDU (the library fragments it into I-blocks).
+///
+/// # Safety
+///
+/// The buffer must stay valid and unchanged until `DATA_TRANSMITTED` or `FIELD_OFF`.
+pub unsafe fn send(pdu: *const u8, len: usize) -> Result<(), NfcError> {
+    check(unsafe { nfc_t4t_response_pdu_send(pdu, len) })
+}
+
+/// Must be called from the NFCT interrupt handler.
+/// Bring-up: if interrupts storm (an event that is never cleared starves everything at lower
+/// priority, including the RTC2 flush timer), persist the trace from the interrupt itself.
+fn check_storm() {
+    use core::sync::atomic::Ordering::Relaxed;
+    static STORM_FLUSHED: core::sync::atomic::AtomicBool = core::sync::atomic::AtomicBool::new(false);
+    let total = DIAG[5].load(Relaxed) + DIAG[6].load(Relaxed);
+    if total >= 1000 && !STORM_FLUSHED.swap(true, Relaxed) {
+        mark(0x92, 0x5707_0000 | (DIAG[5].load(Relaxed) & 0xffff));
+        mark(0x93, reg(0x4000_5304)); // NFCT INTEN
+        mark(0x94, reg(0x4000_8304)); // TIMER0 INTEN
+        mark(0x95, reg(0x4000_8140)); // TIMER0 EVENTS_COMPARE[0]
+        mark(0x96, reg(0xE000_ED04)); // SCB ICSR (VECTACTIVE / VECTPENDING)
+        flush_trace();
+    }
+}
+
+pub fn irq_nfct() {
+    diag_inc(5);
+    check_storm();
+    // RAM trace only (no flash writes here: ISO-DEP timing is a few hundred microseconds).
+    const EV: [usize; 13] = [
+        0x4000_5104, // FIELDDETECTED
+        0x4000_5108, // FIELDLOST
+        0x4000_5138, // AUTOCOLRESSTARTED
+        0x4000_5148, // COLLISION
+        0x4000_514C, // SELECTED
+        0x4000_5114, // RXFRAMESTART
+        0x4000_5118, // RXFRAMEEND
+        0x4000_5128, // RXERROR
+        0x4000_510C, // TXFRAMESTART
+        0x4000_511C, // ERROR
+        0x4000_5110, // TXFRAMEEND
+        0x4000_512C, // ENDRX
+        0x4000_5130, // ENDTX
+    ];
+    let mut mask = 0u32;
+    for (i, a) in EV.iter().enumerate() {
+        if reg(*a) != 0 {
+            mask |= 1 << i;
+        }
+    }
+    vtrace(tag::IRQ_BEFORE, mask | reg(0x4000_540C) << 16, reg(0x4000_5514) | reg(0x4000_5524) << 16);
+    unsafe { nrfx_nfct_irq_handler() }
+    vtrace(tag::IRQ_AFTER, reg(0x4000_5514), reg(0x4000_5510)); // MAXLEN, PACKETPTR
+}
+
+/// Must be called from the TIMER0 interrupt handler (NFCT errata workaround timer).
+pub fn irq_timer0() {
+    diag_inc(6);
+    check_storm();
+    vtrace(tag::TIMER0, reg(0x4000_8140), reg(0x4000_5410));
+    unsafe { nrfx_nfct_workaround_timer_handler() }
+}
+
+// ── nrfx glue (critical section, delay) ──────────────────────────────────────────────────────
+
+#[unsafe(no_mangle)]
+extern "C" fn nrfx_critical_section_enter() -> u8 {
+    let primask = cortex_m::register::primask::read();
+    cortex_m::interrupt::disable();
+    primask.is_active() as u8 // 1 = interrupts were enabled (PRIMASK clear)
+}
+
+#[unsafe(no_mangle)]
+extern "C" fn nrfx_critical_section_exit(was_enabled: u8) {
+    if was_enabled != 0 {
+        unsafe { cortex_m::interrupt::enable() };
+    }
+}
+
+#[unsafe(no_mangle)]
+extern "C" fn nrfx_delay_us(us: u32) {
+    cortex_m::asm::delay(us.saturating_mul(64)); // 64 MHz core
+}
+
+// ── libnfc_t4t platform contract (nfc_platform.h) ────────────────────────────────────────────
+
+type ResolveFn = unsafe extern "C" fn(*const c_void, *const u8);
+
+static mut CB_RESOLVE: Option<ResolveFn> = None;
+
+/// One buffer pool for the library (FSD 256 + WTX frame, TX and RX halves), single-flighted.
+const T4T_BUFFER_SIZE: usize = 259;
+
+/// RX buffer the library asked for in its last `nrfx_nfct_rx` (frames received elsewhere are
+/// copied there before the library sees them).
+static LIB_RX_PTR: core::sync::atomic::AtomicU32 = core::sync::atomic::AtomicU32::new(0);
+static LIB_RX_LEN: core::sync::atomic::AtomicU32 = core::sync::atomic::AtomicU32::new(0);
+/// INTEN bits nrfx enables for RX (learnt from the first normal `nrfx_nfct_rx_impl`).
+static RX_INTEN: core::sync::atomic::AtomicU32 = core::sync::atomic::AtomicU32::new(0);
+
+const SHORT_TX_LEN: usize = 260; // room for a full 257-byte reply
+#[repr(C, align(4))]
+struct ShortBuf([u8; 2 * SHORT_TX_LEN]);
+/// TX buffer for short frames (S-blocks, R-blocks, ATS); doubles as RX room for the reply.
+static mut SHORT_TX: ShortBuf = ShortBuf([0; 2 * SHORT_TX_LEN]);
+#[repr(align(4))]
+// 2 x 259 bytes are used by the library (RX at 0, TX at 0x100, WTX at 0x200); the rest is slack
+// so a short TX can be followed by a reception into the same buffer (see `nrfx_nfct_tx`).
+struct AlignedBuf([u8; 2 * T4T_BUFFER_SIZE + 128]);
+static mut T4T_BUF: AlignedBuf = AlignedBuf([0; 2 * T4T_BUFFER_SIZE + 128]);
+static T4T_BUF_IN_USE: core::sync::atomic::AtomicBool = core::sync::atomic::AtomicBool::new(false);
+
+#[unsafe(no_mangle)]
+unsafe extern "C" fn nfc_platform_setup(resolve: Option<ResolveFn>, irq_priority: *mut u8) -> i32 {
+    if resolve.is_none() || irq_priority.is_null() {
+        return -22; // -EINVAL
+    }
+    unsafe {
+        CB_RESOLVE = resolve;
+        // Highest priority: Wasefire's other interrupts must not delay ISO-DEP frame handling.
+        *irq_priority = 1; // above every other interrupt (they are all at 2)
+    }
+    0
+}
+
+/// NFCID1 derived from FICR.DEVICEADDR; byte 0 = 0x04 (NXP) so iOS treats it as a real tag.
+#[unsafe(no_mangle)]
+unsafe extern "C" fn nfc_platform_nfcid1_default_bytes_get(buf: *mut u8, len: u32) -> i32 {
+    if buf.is_null() {
+        return -22;
+    }
+    if len != 4 && len != 7 && len != 10 {
+        return -7; // -E2BIG
+    }
+    let ficr = 0x1000_0060 as *const u32;
+    let (a, b) = unsafe { (ficr.read_volatile(), ficr.add(1).read_volatile()) };
+    let bytes = [
+        0x04,
+        (a >> 24) as u8,
+        (a >> 16) as u8,
+        (a >> 8) as u8,
+        (b >> 24) as u8,
+        (b >> 16) as u8,
+        (b >> 8) as u8,
+        b as u8,
+        a as u8,
+        ((a >> 16) ^ (b >> 16)) as u8,
+    ];
+    unsafe { core::ptr::copy_nonoverlapping(bytes.as_ptr(), buf, len as usize) };
+    0
+}
+
+/// nrfx NFCT events forwarded by the library: activate on field, restore FRAMEDELAYMAX on loss.
+///
+/// `nrfx_nfct_evt_t` starts with `nrfx_nfct_evt_id_t`, whose values are NFCT INTEN masks up to
+/// bit 20, so even as a packed enum it is 4 bytes wide.
+#[unsafe(no_mangle)]
+unsafe extern "C" fn nfc_platform_event_handler(event: *const u32) {
+    const FIELD_DETECTED: u32 = 1 << 1; // NFCT_INTEN_FIELDDETECTED_Pos = 1
+    const FIELD_LOST: u32 = 1 << 2; // NFCT_INTEN_FIELDLOST_Pos = 2
+    const STATE_ACTIVATED: u8 = 0; // offsetof(NRF_NFCT_Type, TASKS_ACTIVATE)
+    const FRAMEDELAYMAX: *mut u32 = 0x4000_5508 as *mut u32;
+    let id = unsafe { event.read() };
+    diag_or(0, id);
+    // RX_FRAMEEND (0x40): log rx_status | size << 16 and the first frame bytes (event layout:
+    // id @0, rx_status @4, data_size @8, p_data @12).
+    if id == 0x40 {
+        let (st, size, mut p) = unsafe { (event.add(1).read(), event.add(2).read(), event.add(3).read()) };
+        // A frame stored in our TX buffer (shortcut-armed RX): the library only parses its own RX
+        // buffer, so copy the frame there and point the event at it.
+        let lib = LIB_RX_PTR.load(core::sync::atomic::Ordering::Relaxed);
+        if lib != 0 && p != 0 && p != lib {
+            let n = size.min(LIB_RX_LEN.load(core::sync::atomic::Ordering::Relaxed)) as usize;
+            unsafe {
+                core::ptr::copy(p as *const u8, lib as *mut u8, n);
+                (event.add(3) as *mut u32).write(lib);
+            }
+            trace(0xF7, p, n as u32);
+            p = lib;
+        }
+        let head = if p == 0 { 0 } else { unsafe { (p as *const u32).read_unaligned() } };
+        trace(tag::PLATFORM_EVT, id | st << 8 | size << 16, head); // every received frame
+        // RATS (E0 | FSDI << 4 | CID): cap the reader's FSD at 64 bytes (FSDI 5) before the library
+        // parses it, so it chains responses in short frames. Every failure seen on iPhone and
+        // Android came right after a full 254-byte I-block (the reader's next frame was received
+        // as garbage, then the field dropped), while frames up to ~83 bytes always worked.
+        if st == 0 && size == 2 && p != 0 && head & 0xFF == 0xE0 && (head >> 8 & 0xFF) >> 4 > 5 {
+            unsafe { (p as *mut u8).add(1).write_volatile(0x50 | (head >> 8 & 0x0F) as u8) };
+            trace(0xF5, head, 0x50);
+        }
+    } else {
+        if id == 0x2 || id == 0x4 {
+            trace(tag::PLATFORM_EVT, id, reg(0x4000_040C)); // field detected / lost
+        } else {
+            vtrace(tag::PLATFORM_EVT, id, reg(0x4000_040C));
+        }
+    }
+    match id {
+        FIELD_DETECTED => {
+            // nrfx just cleared and started TIMER0 for the errata-190 activation delay. Drop any
+            // stale COMPARE event / pending interrupt so ACTIVATE really happens >= 1 ms later.
+            unsafe {
+                (0x4000_800C as *mut u32).write_volatile(1); // TIMER0 TASKS_CLEAR
+                (0x4000_8140 as *mut u32).write_volatile(0); // TIMER0 EVENTS_COMPARE[0]
+                (0xE000_E280 as *mut u32).write_volatile(1 << 8); // NVIC ICPR0: TIMER0
+            }
+            unsafe { nrfx_nfct_state_force(STATE_ACTIVATED) };
+            diag_inc(1);
+            let tagstate = unsafe { (0x4000_5410 as *const u32).read_volatile() };
+            DIAG[3].store(tagstate, core::sync::atomic::Ordering::Relaxed);
+        }
+        FIELD_LOST => unsafe { FRAMEDELAYMAX.write_volatile(0x1000) },
+        _ => (),
+    }
+}
+
+/// Deferred library callbacks: run them right away (we are already in the NFCT interrupt).
+#[unsafe(no_mangle)]
+unsafe extern "C" fn nfc_platform_cb_request(
+    ctx: *const c_void, _ctx_len: usize, data: *const u8, _data_len: usize, _copy: bool,
+) {
+    diag_inc(2);
+    vtrace(tag::CB_REQUEST, ctx as u32, data as u32);
+    if let Some(resolve) = unsafe { CB_RESOLVE } {
+        unsafe { resolve(ctx, data) };
+    }
+}
+
+#[unsafe(no_mangle)]
+unsafe extern "C" fn nfc_platform_buffer_alloc(size: usize) -> *mut u8 {
+    use core::sync::atomic::Ordering::SeqCst;
+    // Same semantics as Nordic's NCS platform.c: always the same static buffer, no ownership.
+    let _ = &T4T_BUF_IN_USE;
+    let _ = SeqCst;
+    if size > 2 * T4T_BUFFER_SIZE {
+        diag_inc(4);
+        return core::ptr::null_mut();
+    }
+    unsafe { core::ptr::addr_of_mut!(T4T_BUF.0) as *mut u8 }
+}
+
+#[unsafe(no_mangle)]
+unsafe extern "C" fn nfc_platform_buffer_free(buf: *mut u8) {
+    if buf == unsafe { core::ptr::addr_of_mut!(T4T_BUF.0) as *mut u8 } {
+        T4T_BUF_IN_USE.store(false, core::sync::atomic::Ordering::SeqCst);
+    }
+}
