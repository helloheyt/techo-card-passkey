+
+// LilyGO T-Echo Card bring-up diagnostics (same marker page as the runner's techo_debug).
+#[cfg(feature = "techo-beep")]
+mod techo {
+    const MARKER_PAGE: usize = 0x000E_9000;
+    fn write(addr: usize, value: u32) {
+        unsafe { core::ptr::write_volatile(addr as *mut u32, value) };
+    }
+    fn read(addr: usize) -> u32 {
+        unsafe { core::ptr::read_volatile(addr as *const u32) }
+    }
+    pub fn flash_word(index: usize, value: u32) {
+        let addr = MARKER_PAGE + 4 * index;
+        if read(addr) != 0xffff_ffff {
+            return;
+        }
+        while read(0x4001_E400) == 0 {}
+        write(0x4001_E504, 1);
+        while read(0x4001_E400) == 0 {}
+        write(addr, value);
+        while read(0x4001_E400) == 0 {}
+        write(0x4001_E504, 0);
+        while read(0x4001_E400) == 0 {}
+    }
+    /// Erases the marker page on every boot, so the markers always describe the latest boot
+    /// (the page is read back after double-pressing B, which does not run this code).
+    pub fn erase_page() {
+        let resetreas = read(0x4000_0400);
+        while read(0x4001_E400) == 0 {}
+        write(0x4001_E504, 2);
+        while read(0x4001_E400) == 0 {}
+        write(0x4001_E508, MARKER_PAGE as u32);
+        while read(0x4001_E400) == 0 {}
+        write(0x4001_E504, 0);
+        while read(0x4001_E400) == 0 {}
+        flash_word(0x13, resetreas);
+        // The NFC flight-recorder log (0xE0000..0xE9000) is NOT erased here: the runner erases it
+        // on its first flush, so the log of the previous session survives the boot that the
+        // first press of a double-press B causes.
+    }
+    pub fn checkpoint(n: usize) {
+        flash_word(n, 0xC0DE_0000 | n as u32);
+    }
+    pub fn fault(source: u32, pc: u32, lr: u32) -> ! {
+        flash_word(0x40, 0xFA17_FA17);
+        flash_word(0x41, source);
+        flash_word(0x42, pc);
+        flash_word(0x43, lr);
+        flash_word(0x44, read(0xE000_ED28));
+        flash_word(0x45, read(0xE000_ED2C));
+        flash_word(0x46, read(0xE000_ED38));
+        flash_word(0x47, read(0xE000_ED34));
+        loop {
+            cortex_m::asm::nop();
+        }
+    }
+}
+
+// Faults raised before the runner sets VTOR are forwarded by the MBR to this vector table.
+#[cfg(feature = "techo-beep")]
+#[cortex_m_rt::exception]
+unsafe fn HardFault(ef: &cortex_m_rt::ExceptionFrame) -> ! {
+    techo::fault(0x0000_0001, ef.pc(), ef.lr())
+}
