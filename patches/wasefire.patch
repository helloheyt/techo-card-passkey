@@ -0,0 +1,92 @@
+// Bring-up diagnostics for the LilyGO T-Echo Card (no debug probe, no plain LEDs).
+//
+// Every boot checkpoint programs a word in a dedicated flash page (MARKER_PAGE, erased by the
+// UF2 image) and beeps the buzzer (P1.06). After a double reset into the UF2 bootloader the page
+// can be read back from CURRENT.UF2 to see exactly how far boot got and, on a fault, where.
+//
+// Layout of MARKER_PAGE (word index):
+//   0x00..0x0f  checkpoint words: word[n] = 0xC0DE0000 | n when checkpoint n is reached
+//   0x40..0x47  fault record: magic, source, PC, LR, CFSR, HFSR, BFAR, MMFAR
+
+pub const MARKER_PAGE: usize = 0x000E_9000;
+const NVMC_READY: usize = 0x4001_E400;
+const NVMC_CONFIG: usize = 0x4001_E504;
+
+const P1_BASE: usize = 0x5000_0300;
+const OUTSET: usize = P1_BASE + 0x508;
+const OUTCLR: usize = P1_BASE + 0x50C;
+const DIRSET: usize = P1_BASE + 0x518;
+const PIN: u32 = 6;
+const HALF_PERIOD_CYCLES: u32 = 11_800;
+
+fn write(addr: usize, value: u32) {
+    unsafe { core::ptr::write_volatile(addr as *mut u32, value) };
+}
+
+fn read(addr: usize) -> u32 {
+    unsafe { core::ptr::read_volatile(addr as *const u32) }
+}
+
+/// Programs one flash word if it is still erased.
+pub fn flash_word(index: usize, value: u32) {
+    let addr = MARKER_PAGE + 4 * index;
+    if read(addr) != 0xffff_ffff {
+        return;
+    }
+    while read(NVMC_READY) == 0 {}
+    write(NVMC_CONFIG, 1);
+    while read(NVMC_READY) == 0 {}
+    write(addr, value);
+    while read(NVMC_READY) == 0 {}
+    write(NVMC_CONFIG, 0);
+    while read(NVMC_READY) == 0 {}
+}
+
+fn tone(ms: u32) {
+    write(DIRSET, 1 << PIN);
+    let cycles = ms * 64_000 / (2 * HALF_PERIOD_CYCLES);
+    for _ in 0 .. cycles {
+        write(OUTSET, 1 << PIN);
+        cortex_m::asm::delay(HALF_PERIOD_CYCLES);
+        write(OUTCLR, 1 << PIN);
+        cortex_m::asm::delay(HALF_PERIOD_CYCLES);
+    }
+    write(OUTCLR, 1 << PIN);
+}
+
+fn pause(ms: u32) {
+    cortex_m::asm::delay(ms * 64_000);
+}
+
+/// Boot checkpoint `n` (flash marker only) (the Wasefire bootloader records 1 and 2, the runner 3 and up).
+pub fn checkpoint(n: usize) {
+    // Silent: any delay here would stall USB enumeration once the pull-up is enabled.
+    flash_word(n, 0xC0DE_0000 | n as u32);
+}
+
+/// Records a fault and beeps forever.
+pub fn fatal(source: u32, pc: u32, lr: u32) -> ! {
+    flash_word(0x40, 0xFA17_FA17);
+    flash_word(0x41, source);
+    flash_word(0x42, pc);
+    flash_word(0x43, lr);
+    flash_word(0x44, read(0xE000_ED28)); // CFSR
+    flash_word(0x45, read(0xE000_ED2C)); // HFSR
+    flash_word(0x46, read(0xE000_ED38)); // BFAR
+    flash_word(0x47, read(0xE000_ED34)); // MMFAR
+    loop {
+        tone(80);
+        pause(80);
+    }
+}
+
+#[cfg(feature = "release")]
+#[panic_handler]
+fn panic(_: &core::panic::PanicInfo) -> ! {
+    fatal(0x0000_9A41, 0, 0) // "PANIC"
+}
+
+#[cortex_m_rt::exception]
+unsafe fn HardFault(ef: &cortex_m_rt::ExceptionFrame) -> ! {
+    fatal(0x0000_0002, ef.pc(), ef.lr())
+}
