+#!/bin/bash
+# Builds lib/libp256_cm4.a from Emil Lenngren's P256-Cortex-M4 C sources (downloaded into this
+# directory by the installer) for thumbv7em-none-eabi soft-float. Needs clang and llvm-ar.
+set -euo pipefail
+cd "$(dirname "$0")"
+CC=${CC:-clang}
+CFLAGS=(--target=thumbv7em-none-eabi -mthumb -mcpu=cortex-m4 -mfloat-abi=soft -std=c11 -ffreestanding
+        -ffunction-sections -fdata-sections -O2 -Ilibc -I.)
+mkdir -p build lib
+$CC "${CFLAGS[@]}" -c p256-cortex-m4.c -o build/p256-cortex-m4.o
+$CC "${CFLAGS[@]}" -c p256-cortex-m4-asm-gcc.S -o build/p256-cortex-m4-asm.o
+AR=${AR:-$(find "$(rustc --print sysroot)" -name llvm-ar | head -1)}
+rm -f lib/libp256_cm4.a
+"$AR" rcs lib/libp256_cm4.a build/p256-cortex-m4.o build/p256-cortex-m4-asm.o
+echo "built lib/libp256_cm4.a"
