--- /dev/null
+++ b/crates/runner-nordic/src/board/crypto/p256_cm4.rs
@@ -0,0 +1,222 @@
+// P-256 ECDH and ECDSA with Emil Lenngren's P256-Cortex-M4 (MIT, constant time, ~5-15 ms per
+// operation at 64 MHz instead of ~130 ms with the generic software implementation). Same key
+// formats as the software implementation: 32-byte big-endian scalar, 64-byte big-endian x || y.
+
+use core::alloc::Layout;
+
+use p256_cm4::{bytes, words};
+use wasefire_board_api::crypto::{ecdh, ecdsa};
+use wasefire_board_api::rng::Api as _;
+use wasefire_board_api::Supported;
+use wasefire_error::{Code, Error};
+
+pub enum Impl {}
+
+impl Supported for Impl {}
+
+const N: usize = 32;
+
+fn fill(buf: &mut [u8]) -> Result<(), Error> {
+    wasefire_board_api::Rng::<crate::Board>::fill_bytes(buf)
+}
+
+fn zeroize(buf: &mut [u8]) {
+    for x in buf.iter_mut() {
+        unsafe { core::ptr::write_volatile(x, 0) };
+    }
+}
+
+fn generate(private: &mut [u8]) -> Result<(), Error> {
+    if private.len() != N {
+        return Err(Error::user(Code::InvalidLength));
+    }
+    loop {
+        fill(private)?;
+        let (mut x, mut y) = ([0u32; 8], [0u32; 8]);
+        // Fails only when the scalar is not in [1, n-1].
+        if unsafe { p256_cm4::p256_keygen(x.as_mut_ptr(), y.as_mut_ptr(), words(private).as_ptr()) } {
+            return Ok(());
+        }
+    }
+}
+
+fn public(private: &[u8], public: &mut [u8]) -> Result<(), Error> {
+    if private.len() != N || public.len() != 2 * N {
+        return Err(Error::user(Code::InvalidLength));
+    }
+    let (mut x, mut y) = ([0u32; 8], [0u32; 8]);
+    if !unsafe { p256_cm4::p256_keygen(x.as_mut_ptr(), y.as_mut_ptr(), words(private).as_ptr()) } {
+        return Err(Error::user(Code::InvalidArgument));
+    }
+    let (px, py) = public.split_at_mut(N);
+    bytes(&x, px);
+    bytes(&y, py);
+    Ok(())
+}
+
+fn split(public: &[u8]) -> Result<([u32; 8], [u32; 8]), Error> {
+    if public.len() != 2 * N {
+        return Err(Error::user(Code::InvalidLength));
+    }
+    let (x, y) = public.split_at(N);
+    Ok((words(x), words(y)))
+}
+
+fn export_public(public: &[u8], x: &mut [u8; N], y: &mut [u8; N]) -> Result<(), Error> {
+    if public.len() != 2 * N {
+        return Err(Error::user(Code::InvalidLength));
+    }
+    let (px, py) = public.split_at(N);
+    x.copy_from_slice(px);
+    y.copy_from_slice(py);
+    Ok(())
+}
+
+fn import_public(x: &[u8; N], y: &[u8; N], public: &mut [u8]) -> Result<(), Error> {
+    if public.len() != 2 * N {
+        return Err(Error::user(Code::InvalidLength));
+    }
+    let (px, py) = public.split_at_mut(N);
+    px.copy_from_slice(x);
+    py.copy_from_slice(y);
+    Ok(())
+}
+
+impl ecdh::Api<32> for Impl {
+    const PRIVATE: Layout = unsafe { Layout::from_size_align_unchecked(N, 1) };
+    const PUBLIC: Layout = unsafe { Layout::from_size_align_unchecked(2 * N, 1) };
+    const SHARED: Layout = unsafe { Layout::from_size_align_unchecked(N, 1) };
+
+    fn generate(private: &mut [u8]) -> Result<(), Error> {
+        generate(private)
+    }
+
+    fn public(private: &[u8], public_: &mut [u8]) -> Result<(), Error> {
+        public(private, public_)
+    }
+
+    fn shared(private: &[u8], public: &[u8], shared: &mut [u8]) -> Result<(), Error> {
+        if private.len() != N || shared.len() != N {
+            return Err(Error::user(Code::InvalidLength));
+        }
+        let (x, y) = split(public)?;
+        let d = words(private);
+        // Fails when the peer's point is not on the curve.
+        if !unsafe {
+            p256_cm4::p256_ecdh_calc_shared_secret(shared.as_mut_ptr(), d.as_ptr(), x.as_ptr(), y.as_ptr())
+        } {
+            return Err(Error::user(Code::InvalidArgument));
+        }
+        Ok(())
+    }
+
+    fn drop_private(private: &mut [u8]) -> Result<(), Error> {
+        zeroize(private);
+        Ok(())
+    }
+
+    fn drop_shared(shared: &mut [u8]) -> Result<(), Error> {
+        zeroize(shared);
+        Ok(())
+    }
+
+    fn export_public(public: &[u8], x: &mut [u8; N], y: &mut [u8; N]) -> Result<(), Error> {
+        export_public(public, x, y)
+    }
+
+    fn import_public(x: &[u8; N], y: &[u8; N], public: &mut [u8]) -> Result<(), Error> {
+        import_public(x, y, public)
+    }
+
+    fn export_shared(shared: &[u8], x: &mut [u8; N]) -> Result<(), Error> {
+        if shared.len() != N {
+            return Err(Error::user(Code::InvalidLength));
+        }
+        x.copy_from_slice(shared);
+        Ok(())
+    }
+}
+
+impl ecdsa::Api<32> for Impl {
+    const PRIVATE: Layout = unsafe { Layout::from_size_align_unchecked(N, 1) };
+    const PUBLIC: Layout = unsafe { Layout::from_size_align_unchecked(2 * N, 1) };
+    const WRAPPED: usize = N;
+
+    fn generate(private: &mut [u8]) -> Result<(), Error> {
+        generate(private)
+    }
+
+    fn public(private: &[u8], public_: &mut [u8]) -> Result<(), Error> {
+        public(private, public_)
+    }
+
+    fn sign(private: &[u8], digest: &[u8; N], r: &mut [u8; N], s: &mut [u8; N]) -> Result<(), Error> {
+        if private.len() != N {
+            return Err(Error::user(Code::InvalidLength));
+        }
+        let d = words(private);
+        let mut k = [0u8; N];
+        let result = loop {
+            fill(&mut k)?;
+            let (mut rw, mut sw) = ([0u32; 8], [0u32; 8]);
+            // Fails with probability ~2^-32 (or for an invalid private key): retry with a new k.
+            let ok = unsafe {
+                p256_cm4::p256_sign(
+                    rw.as_mut_ptr(), sw.as_mut_ptr(), digest.as_ptr(), N as u32, d.as_ptr(),
+                    words(&k).as_ptr(),
+                )
+            };
+            if ok {
+                bytes(&rw, r);
+                bytes(&sw, s);
+                break Ok(());
+            }
+            // An invalid private key fails for every k.
+            let (mut x, mut y) = ([0u32; 8], [0u32; 8]);
+            if !unsafe { p256_cm4::p256_keygen(x.as_mut_ptr(), y.as_mut_ptr(), d.as_ptr()) } {
+                break Err(Error::user(Code::InvalidArgument));
+            }
+        };
+        zeroize(&mut k);
+        result
+    }
+
+    fn verify(public: &[u8], digest: &[u8; N], r: &[u8; N], s: &[u8; N]) -> Result<bool, Error> {
+        let (x, y) = split(public)?;
+        Ok(unsafe {
+            p256_cm4::p256_verify(
+                x.as_ptr(), y.as_ptr(), digest.as_ptr(), N as u32, words(r).as_ptr(),
+                words(s).as_ptr(),
+            )
+        })
+    }
+
+    fn drop_private(private: &mut [u8]) -> Result<(), Error> {
+        zeroize(private);
+        Ok(())
+    }
+
+    fn export_private(private: &[u8], wrapped: &mut [u8]) -> Result<(), Error> {
+        if private.len() != N || wrapped.len() != N {
+            return Err(Error::user(Code::InvalidLength));
+        }
+        wrapped.copy_from_slice(private);
+        Ok(())
+    }
+
+    fn import_private(wrapped: &[u8], private: &mut [u8]) -> Result<(), Error> {
+        if wrapped.len() != N || private.len() != N {
+            return Err(Error::user(Code::InvalidLength));
+        }
+        private.copy_from_slice(wrapped);
+        Ok(())
+    }
+
+    fn export_public(public: &[u8], x: &mut [u8; N], y: &mut [u8; N]) -> Result<(), Error> {
+        export_public(public, x, y)
+    }
+
+    fn import_public(x: &[u8; N], y: &[u8; N], public: &mut [u8]) -> Result<(), Error> {
+        import_public(x, y, public)
+    }
+}
