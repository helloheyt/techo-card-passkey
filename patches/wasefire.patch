@@ -0,0 +1,29 @@
+//! FFI to P256-Cortex-M4 (MIT). Scalars and coordinates are `[u32; 8]` little-endian words
+//! (word 0 is the least significant), 4-byte aligned.
+#![no_std]
+
+unsafe extern "C" {
+    pub fn p256_keygen(x: *mut u32, y: *mut u32, private_key: *const u32) -> bool;
+    pub fn p256_sign(
+        r: *mut u32, s: *mut u32, hash: *const u8, hash_len: u32, private_key: *const u32,
+        k: *const u32,
+    ) -> bool;
+    pub fn p256_verify(
+        x: *const u32, y: *const u32, hash: *const u8, hash_len: u32, r: *const u32, s: *const u32,
+    ) -> bool;
+    pub fn p256_ecdh_calc_shared_secret(
+        shared: *mut u8, private_key: *const u32, x: *const u32, y: *const u32,
+    ) -> bool;
+}
+
+/// Big-endian 32 bytes to little-endian words.
+pub fn words(b: &[u8]) -> [u32; 8] {
+    core::array::from_fn(|i| u32::from_be_bytes(b[28 - 4 * i .. 32 - 4 * i].try_into().unwrap()))
+}
+
+/// Little-endian words to big-endian 32 bytes.
+pub fn bytes(w: &[u32; 8], out: &mut [u8]) {
+    for (i, x) in w.iter().enumerate() {
+        out[28 - 4 * i .. 32 - 4 * i].copy_from_slice(&x.to_be_bytes());
+    }
+}
