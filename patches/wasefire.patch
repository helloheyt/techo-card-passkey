+#!/bin/bash
+# Rebuilds ../lib/libnrfx_nfct.a (nrfx NFCT + TIMER drivers, BSD-3-Clause) for thumbv7em-none-eabi
+# soft-float. Needs clang (Apple or LLVM), git and llvm-ar (`rustup component add llvm-tools`).
+# Run by the installer (nothing from nrfx is shipped in this repository).
+set -e
+cd "$(dirname "$0")"
+[ -d nrfx ] || git -c advice.detachedHead=false clone -q --depth 1 --branch v4.2.1 https://github.com/NordicSemiconductor/nrfx.git nrfx
+if [ ! -d cmsis ]; then
+  git init -q cmsis && git -C cmsis fetch -q --depth 1 https://github.com/ARM-software/CMSIS_6.git f6226079fdb207e945dae7cea2c273ea5200376a
+  git -C cmsis checkout -q FETCH_HEAD
+fi
+# Patch: report TX events before RX events when the interrupt is serviced late (see the patch).
+git -C nrfx apply --check ../nrfx_nfct-techo.patch 2>/dev/null && git -C nrfx apply ../nrfx_nfct-techo.patch
+CMSIS_INC=cmsis/CMSIS/Core/Include
+INC=(-Iglue -Ilibc -I$CMSIS_INC -Inrfx/drivers/include -Inrfx/hal -Inrfx/haly -Inrfx/helpers
+     -Inrfx/templates -Inrfx/bsp/stable -Inrfx/bsp/stable/mdk -Inrfx/bsp/stable/soc
+     -Inrfx/bsp/stable/soc/irqs -Inrfx/bsp/stable/soc/interconnect -Inrfx/bsp/stable/templates -Inrfx)
+CC=${CC:-clang}
+for src in nrfx_nfct nrfx_timer; do
+  $CC --target=thumbv7em-none-eabi -mthumb -mcpu=cortex-m4 -mfloat-abi=soft -fshort-enums -ffreestanding \
+    -fno-builtin -fno-strict-aliasing -ffunction-sections -fdata-sections -O2 \
+    -DNRF52840_XXAA -Dnrfx_nfct_rx=nrfx_nfct_rx_impl -Dnrfx_nfct_tx=nrfx_nfct_tx_impl \
+    -D__HEAP_SIZE=0 -D__STACK_SIZE=0 -Wno-unused-parameter -Wno-expansion-to-defined \
+    "${INC[@]}" -c -o $src.o nrfx/drivers/src/$src.c
+done
+AR=${AR:-$(find "$(rustc --print sysroot)" -name llvm-ar | head -1)}
+rm -f ../lib/libnrfx_nfct.a && "$AR" rcs ../lib/libnrfx_nfct.a nrfx_nfct.o nrfx_timer.o
+echo "built ../lib/libnrfx_nfct.a"
