diff --git a/crates/runner-nordic/src/board/vendor/nfc.rs b/crates/runner-nordic/src/board/vendor/nfc.rs
new file mode 100644
index 0000000..d2e9e56
--- /dev/null
+++ b/crates/runner-nordic/src/board/vendor/nfc.rs
@@ -0,0 +1,466 @@
+// NFC (ISO 14443-4 Type 4 Tag, raw ISO-DEP) vendor API for the LilyGO T-Echo Card.
+//
+// The applet (OpenSK) drives it through vendor syscall SYSCALL_ID:
+//   OP_REGISTER(func, data)  register the event handler; arms the KEY_1 (button A) wake detector
+//   OP_UNREGISTER            unregister
+//   OP_START / OP_STOP       start/stop tag emulation (NFCT sensing)
+//   OP_READ(ptr, len)        copy the pending complete C-APDU, returns its length (0 if none)
+//   OP_SEND(ptr, len)        send an R-APDU for the last C-APDU
+//   OP_STATUS                bit0 emulation running, bit1 field present, bit2 C-APDU pending,
+//                            bit3 button A pressed since the last OP_STATUS (cleared on read)
+// A single coalesced vendor event (Event::Nfc) is raised whenever any of these change.
+//
+// Button A detection uses the GPIO SENSE/PORT mechanism on P1.10 rather than a GPIOTE IN channel,
+// so it does not conflict with the applet's own use of button 0 for user presence.
+
+use alloc::vec::Vec;
+use core::cell::RefCell;
+
+use critical_section::Mutex;
+use wasefire_board_api::Failure;
+use wasefire_board_api::applet::{Handlers, Memory};
+use wasefire_board_api::vendor::Event as BoardEvent;
+use wasefire_error::{Code, Error};
+
+use crate::with_state;
+
+pub const SYSCALL_ID: u32 = 0x8000_0002;
+const OP_REGISTER: u32 = 1;
+const OP_UNREGISTER: u32 = 2;
+const OP_START: u32 = 3;
+const OP_STOP: u32 = 4;
+const OP_READ: u32 = 5;
+const OP_SEND: u32 = 6;
+const OP_STATUS: u32 = 7;
+
+const RX_MAX: usize = 4096;
+const TX_MAX: usize = 4096;
+
+struct Nfc {
+    initialized: bool,
+    registered: bool,
+    running: bool,
+    field: bool,
+    button: bool,
+    rx: Vec<u8>,
+    rx_complete: bool,
+}
+
+static NFC: Mutex<RefCell<Nfc>> = Mutex::new(RefCell::new(Nfc {
+    initialized: false,
+    registered: false,
+    running: false,
+    field: false,
+    button: false,
+    rx: Vec::new(),
+    rx_complete: false,
+}));
+
+/// The response buffer must outlive the ISO-DEP transmission, so it is static.
+struct TxBuf(core::cell::UnsafeCell<[u8; TX_MAX]>);
+unsafe impl Sync for TxBuf {}
+static TX: TxBuf = TxBuf(core::cell::UnsafeCell::new([0; TX_MAX]));
+
+fn with_nfc<R>(f: impl FnOnce(&mut Nfc) -> R) -> R {
+    critical_section::with(|cs| f(&mut NFC.borrow_ref_mut(cs)))
+}
+
+fn notify() {
+    if with_nfc(|n| n.registered) {
+        with_state(|state| state.events.push(BoardEvent(super::Event::Nfc).into()));
+    }
+}
+
+fn to_error(_: nrf_nfc::NfcError) -> Error {
+    Error::world(Code::InvalidState)
+}
+
+pub fn syscall(
+    memory: impl Memory, mut handlers: impl Handlers<super::Key>, x2: u32, x3: u32, x4: u32,
+) -> Result<u32, Failure> {
+    match (x2, x3, x4) {
+        (OP_REGISTER, func, data) => {
+            handlers.register(super::Key::Nfc, func, data)?;
+            #[cfg(feature = "board-techo")]
+            crate::techo_debug::flash_word(0x30, 0x0000_4E01); // NFC registered
+            init()?;
+            with_nfc(|n| n.registered = true);
+            arm_button();
+            Ok(0)
+        }
+        (OP_UNREGISTER, 0, 0) => {
+            with_nfc(|n| n.registered = false);
+            handlers.unregister(super::Key::Nfc)?;
+            Ok(0)
+        }
+        (OP_START, 0, 0) => {
+            if !with_nfc(|n| core::mem::replace(&mut n.running, true)) {
+                let result = nrf_nfc::start();
+                #[cfg(feature = "board-techo")]
+                crate::techo_debug::flash_word(0x33, 0x5000_0000 | (result.err().map_or(0, |e| e.0) as u32 & 0xffff));
+                result.map_err(to_error)?;
+            }
+            Ok(0)
+        }
+        (OP_STOP, 0, 0) => {
+            if with_nfc(|n| core::mem::replace(&mut n.running, false)) {
+                nrf_nfc::stop().map_err(to_error)?;
+            }
+            with_nfc(|n| {
+                n.field = false;
+                n.rx.clear();
+                n.rx_complete = false;
+            });
+            // Bring-up: emulation is stopped, so persisting the trace cannot disturb an exchange.
+            #[cfg(feature = "board-techo")]
+            nrf_nfc::flush_trace();
+            Ok(0)
+        }
+        (OP_READ, ptr, len) => {
+            let output = memory.get_mut(ptr, len)?;
+            Ok(with_nfc(|n| {
+                if !n.rx_complete {
+                    return Ok(0);
+                }
+                let size = n.rx.len();
+                if size > output.len() {
+                    return Err(Error::user(Code::InvalidLength));
+                }
+                output[.. size].copy_from_slice(&n.rx);
+                #[cfg(feature = "board-techo")]
+                {
+                    crate::techo_debug::flash_word(0xA0, 0xAD00_0000 | size as u32); // applet read APDU
+                    let head = u32::from_be_bytes([n.rx[0], *n.rx.get(1).unwrap_or(&0), *n.rx.get(2).unwrap_or(&0), *n.rx.get(3).unwrap_or(&0)]);
+                    crate::techo_debug::flash_word(0xA1, head);
+                    crate::techo_debug::flash_word(0xA8, cycles_now());
+                }
+                n.rx.clear();
+                n.rx_complete = false;
+                Ok(size as u32)
+            })?)
+        }
+        (OP_SEND, ptr, len) => {
+            let input = memory.get(ptr, len)?;
+            if input.len() > TX_MAX {
+                return Err(Error::user(Code::InvalidLength).into());
+            }
+            // Safety: the previous response was handed to the library before this new request was
+            // received, so ISO-DEP is done with the buffer.
+            let tx = unsafe { &mut *TX.0.get() };
+            tx[.. input.len()].copy_from_slice(input);
+            let result = unsafe { nrf_nfc::send(tx.as_ptr(), input.len()) };
+            #[cfg(feature = "board-techo")]
+            {
+                // R-APDU: length, first 4 bytes, status word and send result.
+                let mut head = [0u8; 4];
+                for (d, s) in head.iter_mut().zip(input.iter()) {
+                    *d = *s;
+                }
+                let sw = if input.len() >= 2 {
+                    u16::from_be_bytes([input[input.len() - 2], input[input.len() - 1]]) as u32
+                } else {
+                    0
+                };
+                nrf_nfc::trace(0xA7, input.len() as u32, u32::from_be_bytes(head));
+                nrf_nfc::trace(0xA9, sw, result.err().map_or(0, |e| e.0) as u32);
+                // Full R-APDU body after the first 4 bytes (8 bytes per entry).
+                let r = |i: usize| {
+                    let mut b = [0u8; 4];
+                    for (k, x) in b.iter_mut().enumerate() {
+                        *x = input.get(i + k).copied().unwrap_or(0);
+                    }
+                    u32::from_be_bytes(b)
+                };
+                let mut i = 4;
+                while LOG_APDU_DATA && i < input.len().min(400) {
+                    nrf_nfc::trace(0xAB, r(i), r(i + 4));
+                    i += 8;
+                }
+                crate::techo_debug::flash_word(0xA7, cycles_now());
+                crate::techo_debug::flash_word(0xA2, 0x5E00_0000 | input.len() as u32); // applet sent R-APDU
+                let mut h = [0u8; 4];
+                for (d, s) in h.iter_mut().zip(input.iter()) {
+                    *d = *s;
+                }
+                crate::techo_debug::flash_word(0xA3, u32::from_be_bytes(h));
+                crate::techo_debug::flash_word(0xA4, 0x7E5E_0000 | (result.err().map_or(0, |e| e.0) as u32 & 0xffff));
+            }
+            result.map_err(to_error)?;
+            Ok(0)
+        }
+        (OP_STATUS, 0, 0) => Ok({
+            with_nfc(|n| {
+            let status = n.running as u32
+                | (n.field as u32) << 1
+                | (n.rx_complete as u32) << 2
+                | (n.button as u32) << 3;
+            n.button = false;
+            status
+        })}),
+        _ => Err(Failure::TRAP),
+    }
+}
+
+fn init() -> Result<(), Error> {
+    if with_nfc(|n| core::mem::replace(&mut n.initialized, true)) {
+        return Ok(());
+    }
+    with_nfc(|n| n.rx.reserve_exact(RX_MAX));
+    #[cfg(feature = "board-techo")]
+    unsafe {
+        nrf_nfc::MARK = Some(crate::techo_debug::flash_word);
+    }
+    let result = unsafe { nrf_nfc::setup(callback) };
+    #[cfg(feature = "board-techo")]
+    crate::techo_debug::flash_word(0x31, 0x5E70_0000 | (result.err().map_or(0, |e| e.0) as u32 & 0xffff));
+    #[cfg(feature = "board-techo")]
+    start_flush_timer();
+    // Keep the library's default FWI (4): it extends the time automatically with S(WTX) requests.
+    // Advertising FWI 8 made Android stop discovering the tag.
+    result.map_err(to_error)
+}
+
+/// Called by the Type 4 Tag library from the NFCT interrupt.
+unsafe extern "C" fn callback(
+    _ctx: *mut core::ffi::c_void, event: u8, data: *const u8, len: usize, flags: u32,
+) {
+    use nrf_nfc::event::*;
+    if event != nrf_nfc::event::DATA_IND {
+        nrf_nfc::trace(nrf_nfc::tag::APP_EVT, event as u32, len as u32);
+    }
+    let mut empty = false;
+    let changed = with_nfc(|n| match event {
+        FIELD_ON => {
+            n.field = true;
+            true
+        }
+        FIELD_OFF => {
+            n.field = false;
+            n.rx.clear();
+            n.rx_complete = false;
+            true
+        }
+        DATA_IND => {
+            if n.rx_complete {
+                // A new C-APDU while the previous one is unanswered: start over with this one.
+                n.rx.clear();
+                n.rx_complete = false;
+            }
+            if len > 0 && !data.is_null() {
+                let chunk = unsafe { core::slice::from_raw_parts(data, len) };
+                if n.rx.len() + chunk.len() <= RX_MAX {
+                    n.rx.extend_from_slice(chunk);
+                }
+            }
+            if flags & nrf_nfc::DI_FLAG_MORE == 0 && n.rx.is_empty() {
+                // Empty I-block (reader presence check): it must be answered right away or the
+                // library keeps waiting for a response and drops every later frame.
+                empty = true;
+                false
+            } else if flags & nrf_nfc::DI_FLAG_MORE == 0 {
+                #[cfg(feature = "board-techo")]
+                {
+                    // C-APDU complete: length, CLA INS P1 P2, then bytes 4..8 (Lc / CTAP command).
+                    let w = |i: usize| {
+                        let mut b = [0u8; 4];
+                        for (k, x) in b.iter_mut().enumerate() {
+                            *x = n.rx.get(i + k).copied().unwrap_or(0);
+                        }
+                        u32::from_be_bytes(b)
+                    };
+                    nrf_nfc::trace(0xA5, n.rx.len() as u32, w(0));
+                    nrf_nfc::trace(0xA8, w(4), w(8));
+                    // Full C-APDU body (8 bytes per entry) for offline CBOR decoding.
+                    let mut i = 12;
+                    while LOG_APDU_DATA && i < n.rx.len().min(400) {
+                        nrf_nfc::trace(0xAA, w(i), w(i + 4));
+                        i += 8;
+                    }
+                }
+                n.rx_complete = true;
+                true
+            } else {
+                false
+            }
+        }
+        DATA_TRANSMITTED => false,
+        _ => false,
+    });
+    if empty {
+        static EMPTY_OK: [u8; 2] = [0x90, 0x00];
+        let r = unsafe { nrf_nfc::send(EMPTY_OK.as_ptr(), 0) };
+        let r2 = if r.is_err() { unsafe { nrf_nfc::send(EMPTY_OK.as_ptr(), 2) } } else { Ok(()) };
+        nrf_nfc::trace(0xA6, r.err().map_or(0, |e| e.0) as u32, r2.err().map_or(0, |e| e.0) as u32);
+    }
+    if changed {
+        notify();
+    }
+}
+
+// ── Button A (KEY_1, P1.10) wake detector via GPIO SENSE + GPIOTE PORT event ───────────────────
+
+const P1_PIN_CNF_10: usize = 0x5000_0300 + 0x700 + 4 * 10;
+const P1_IN: usize = 0x5000_0300 + 0x510;
+const GPIOTE_EVENTS_PORT: usize = 0x4000_617C;
+const GPIOTE_INTENSET: usize = 0x4000_6304;
+
+fn reg_read(addr: usize) -> u32 {
+    unsafe { core::ptr::read_volatile(addr as *const u32) }
+}
+
+fn reg_write(addr: usize, value: u32) {
+    unsafe { core::ptr::write_volatile(addr as *mut u32, value) }
+}
+
+fn arm_button() {
+    // SENSE = Low (3 << 16), keeping direction/input/pull as configured by the runner.
+    let cnf = reg_read(P1_PIN_CNF_10) & !(3 << 16);
+    reg_write(P1_PIN_CNF_10, cnf | (3 << 16));
+    reg_write(GPIOTE_EVENTS_PORT, 0);
+    reg_write(GPIOTE_INTENSET, 1 << 31);
+}
+
+/// Called from the GPIOTE interrupt.
+pub fn gpiote_port() {
+    if reg_read(GPIOTE_EVENTS_PORT) == 0 {
+        return;
+    }
+    reg_write(GPIOTE_EVENTS_PORT, 0);
+    let pressed = reg_read(P1_IN) & (1 << 10) == 0;
+    #[cfg(feature = "board-techo")]
+    crate::techo_debug::flash_word(0x32, 0xB070_0000 | pressed as u32); // PORT event (button A)
+    #[cfg(feature = "board-techo")]
+    if pressed {
+        nrf_nfc::flush_trace(); // bring-up: press A after a test to persist the NFC trace
+    }
+    if pressed && with_nfc(|n| n.registered) {
+        with_nfc(|n| n.button = true);
+        notify();
+    }
+}
+
+pub fn irq_nfct() {
+    nrf_nfc::irq_nfct();
+}
+
+/// Bring-up: persists the RAM trace once it has stopped growing for 2 ticks of RTC2 (1 s each).
+/// Runs from its own RTC interrupt so it does not depend on the applet polling or on button A.
+#[cfg(feature = "board-techo")]
+pub fn irq_rtc2() {
+    use core::sync::atomic::AtomicUsize;
+    use core::sync::atomic::Ordering::Relaxed;
+    const RTC2: usize = 0x4002_4000;
+    reg_write(RTC2 + 0x140, 0); // EVENTS_COMPARE[0]
+    reg_write(RTC2 + 0x008, 1); // TASKS_CLEAR
+    static TICKS: AtomicUsize = AtomicUsize::new(0);
+    static FLUSHED: AtomicUsize = AtomicUsize::new(0);
+    static LAST_LEN: AtomicUsize = AtomicUsize::new(0);
+    static STABLE: AtomicUsize = AtomicUsize::new(0);
+    // Button A (KEY_1, P1.10, active low): polled every 125 ms. The GPIO SENSE/PORT detector never
+    // fired on this board, and the pin's GPIOTE channel belongs to the applet's user-presence
+    // check, so polling is the reliable way to open the NFC window.
+    static WAS_PRESSED: core::sync::atomic::AtomicBool = core::sync::atomic::AtomicBool::new(false);
+    let pressed = reg_read(P1_IN) & (1 << 10) == 0;
+    if pressed && !WAS_PRESSED.swap(true, Relaxed) {
+        crate::techo_debug::flash_word(0x32, 0xB070_0001); // button A seen
+        if with_nfc(|n| n.registered) {
+            with_nfc(|n| n.button = true);
+            notify();
+        }
+    } else if !pressed {
+        WAS_PRESSED.store(false, Relaxed);
+    }
+    static SUB: AtomicUsize = AtomicUsize::new(0);
+    if SUB.fetch_add(1, Relaxed) % 8 != 7 {
+        return; // the rest runs once per second
+    }
+    let n = nrf_nfc::TRACE_LEN.load(Relaxed); // total entries ever (the trace is a ring)
+    let tick = TICKS.fetch_add(1, Relaxed);
+    if tick == 0 {
+        crate::techo_debug::flash_word(0x90, 0x7100_0000 | n as u32); // first RTC2 tick
+    }
+    if n == LAST_LEN.swap(n, Relaxed) {
+        STABLE.fetch_add(1, Relaxed);
+    } else {
+        STABLE.store(0, Relaxed);
+    }
+    // Flash writes stall the CPU (~40 us each, hundreds of them): only flush once no reader field
+    // has been present for a while, or presence checks go unanswered and the phone drops the tag.
+    static NO_FIELD: AtomicUsize = AtomicUsize::new(0);
+    // FIELD_OFF is not always delivered, so look at the hardware: field present or lock detected,
+    // or the tag not back in sense mode (NFCTAGSTATE 0 = disabled/sensing).
+    let field = reg_read(0x4000_543C) & 3 != 0 || reg_read(0x4000_5410) != 0;
+    if field {
+        NO_FIELD.store(0, Relaxed);
+    } else {
+        NO_FIELD.fetch_add(1, Relaxed);
+    }
+    if n > 2 && n > FLUSHED.load(Relaxed) && STABLE.load(Relaxed) >= 2 && NO_FIELD.load(Relaxed) >= 3 {
+        crate::techo_debug::flash_word(0x91, 0xF100_0000 | n as u32); // flush attempt
+        nrf_nfc::flush_trace();
+        FLUSHED.store(n, Relaxed);
+    }
+}
+
+/// Finds the exception frame of the outermost handler by scanning up the stack for the
+/// EXC_RETURN value its prologue pushed, and returns the interrupted PC (0 if not found).
+#[cfg(feature = "board-techo")]
+#[inline(never)]
+fn stacked_pc() -> (u32, u32) {
+    let sp = cortex_m::register::msp::read() as usize;
+    for i in 0 .. 96 {
+        let addr = sp + 4 * i;
+        if addr + 32 >= 0x2004_0000 {
+            break;
+        }
+        let w = unsafe { (addr as *const u32).read_volatile() };
+        if matches!(w, 0xFFFF_FFF1 | 0xFFFF_FFF9 | 0xFFFF_FFFD | 0xFFFF_FFE1 | 0xFFFF_FFE9 | 0xFFFF_FFED) {
+            let frame = addr + 4;
+            let pc = unsafe { ((frame + 24) as *const u32).read_volatile() };
+            let lr = unsafe { ((frame + 20) as *const u32).read_volatile() };
+            return (pc, lr);
+        }
+    }
+    (0, 0)
+}
+
+#[cfg(feature = "board-techo")]
+fn start_flush_timer() {
+    const CLOCK: usize = 0x4000_0000;
+    const RTC2: usize = 0x4002_4000;
+    if reg_read(CLOCK + 0x418) & (1 << 16) == 0 {
+        // LFCLK not running: start the internal RC oscillator.
+        reg_write(CLOCK + 0x104, 0); // EVENTS_LFCLKSTARTED
+        reg_write(CLOCK + 0x518, 0); // LFCLKSRC = RC
+        reg_write(CLOCK + 0x008, 1); // TASKS_LFCLKSTART
+        let mut spins = 0u32;
+        while reg_read(CLOCK + 0x104) == 0 && spins < 2_000_000 {
+            spins += 1;
+        }
+    }
+    reg_write(RTC2 + 0x004, 1); // TASKS_STOP
+    reg_write(RTC2 + 0x508, 4095); // PRESCALER: 8 Hz
+    reg_write(RTC2 + 0x540, 1); // CC[0]: 125 ms (button A poll; the trace flush runs every 8th tick)
+    reg_write(RTC2 + 0x140, 0);
+    reg_write(RTC2 + 0x304, 1 << 16); // INTENSET COMPARE0
+    reg_write(RTC2 + 0x008, 1); // TASKS_CLEAR
+    reg_write(RTC2 + 0x000, 1); // TASKS_START
+}
+
+pub fn irq_timer0() {
+    nrf_nfc::irq_timer0();
+}
+
+pub fn disable() -> Result<(), Error> {
+    with_nfc(|n| n.registered = false);
+    Ok(())
+}
