+# usbpersist.py create  -> makes a resident test credential for rp "persist.invalid" (press A)
+# usbpersist.py check   -> silent getAssertion (up=false) for that credential: KEPT / GONE
+import sys, os, time, hashlib, json
+from fido2.hid import CtapHidDevice
+from fido2.ctap2 import Ctap2
+from fido2.ctap import CtapError
+F = "persist_cred.json"  # written to the current directory
+for _ in range(600):
+    devs = [d for d in CtapHidDevice.list_devices() if d.descriptor.product_name == "Wasefire"]
+    if devs: break
+    time.sleep(1)
+ctap = Ctap2(devs[0])
+cdh = hashlib.sha256(b"persist").digest()
+if sys.argv[1] == "create":
+    print("press button A", flush=True)
