@@ -0,0 +1,209 @@
+#!/usr/bin/env python3
+"""Decode the T-Echo bring-up marker page (0xE9000) from a CURRENT.UF2 dump.
+
+Usage: techo_markers.py /Volumes/NRF52BOOT/CURRENT.UF2
+"""
+import struct
+import sys
+
+MARKER_PAGE = 0xE9000
+STAGES = {
+    1: "Wasefire bootloader started",
+    2: "Wasefire bootloader about to jump to runner",
+    3: "runner main() started",
+    4: "runner: GPIO/timers set up, about to start HFXO",
+    5: "runner: HFXO (32 MHz crystal) running",
+    6: "runner: USB device created",
+    7: "runner: storage initialised",
+    8: "runner: entering scheduler (OpenSK)",
+}
+
+
+def main():
+    data = open(sys.argv[1], "rb").read()
+    mem = {}
+    for i in range(len(data) // 512):
+        blk = data[i * 512:(i + 1) * 512]
+        addr, size = struct.unpack("<II", blk[12:20])
+        mem[addr] = blk[32:32 + size]
+    page = b"".join(mem.get(MARKER_PAGE + off, b"\xee" * 256) for off in range(0, 0x1000, 256))
+    words = struct.unpack("<1024I", page)
+    if all(w == 0xEEEEEEEE for w in words):
+        sys.exit("marker page not present in dump")
+    reached = [n for n in STAGES if words[n] == 0xC0DE0000 | n]
+    for n, desc in STAGES.items():
+        print(f"  [{'x' if n in reached else ' '}] {n}: {desc}")
+    if words[0x10] != 0xFFFFFFFF:
+        rr = words[0x13]
+        if rr != 0xFFFFFFFF:
+            names = {0:'RESETPIN(B)',1:'DOG',2:'SREQ(soft reset)',3:'LOCKUP',16:'OFF',17:'LPCOMP',18:'DIF',19:'NFC',20:'VBUS'}
+            print(f"  boot reset reason RESETREAS=0x{rr:08X} " + ",".join(n for b,n in names.items() if rr>>b&1) + (" (power-on)" if rr==0 else ""))
+        print(f"  jump target vector table 0x{words[0x10]:08X}: SP=0x{words[0x11]:08X} "
+              f"reset=0x{words[0x12]:08X}")
+    if words[0x20] != 0xFFFFFFFF:
+        r = words[0x20]
+        print(f"  USB at stage 6: USBREGSTATUS=0x{r:X} (VBUSDETECT={r & 1}, OUTPUTRDY={(r >> 1) & 1}) "
+              f"USBPULLUP={words[0x21]} USBD.ENABLE={words[0x22]}")
+    print("  first USBD interrupt:", f"EVENTCAUSE=0x{words[0x23] & 0xFFFFFFF:X}" if words[0x23] != 0xFFFFFFFF else "never")
+    print("  host bus reset seen:", words[0x24] == 0xBE5E7)
+    print("  host assigned address:", words[0x25] == 0xADD)
+    print("  host configured device:", words[0x26] == 0xC0F16)
+    if words[0x27] != 0xFFFFFFFF:
+        print(f"  KEY_1 (P1.10) idle level after pull-up: {words[0x27] & 1} (1 = released, as expected)")
+    print("  button interrupt (GPIOTE) seen:", words[0x28] == 0x9107)
+    names = {1: "FIELD_ON", 2: "FIELD_OFF", 3: "NDEF_READ", 4: "NDEF_UPDATED", 5: "DATA_TRANSMITTED", 6: "DATA_IND"}
+    print("  NFC registered by OpenSK:", words[0x30] == 0x4E01)
+    if words[0x31] != 0xFFFFFFFF:
+        print(f"  nfc_t4t_setup result: {-(0x10000 - (words[0x31] & 0xffff)) if words[0x31] & 0x8000 else words[0x31] & 0xffff}")
+    print("  button A PORT event:", "never" if words[0x32] == 0xFFFFFFFF else f"seen (pressed={words[0x32] & 1})")
+    if words[0x33] != 0xFFFFFFFF:
+        v = words[0x33] & 0xffff
+        print(f"  nfc_t4t_emulation_start result: {v - 0x10000 if v & 0x8000 else v}")
+    else:
+        print("  nfc_t4t_emulation_start: never called")
+    seen = [names.get(e, e) for e in range(8) if words[0x34 + e] != 0xFFFFFFFF]
+    print("  T4T events seen:", seen or "none")
+    if words[0x60] != 0xFFFFFFFF:
+        ev = words[0x60]
+        bits = {1: "FIELDDETECTED", 2: "FIELDLOST", 3: "TXFRAMESTART", 4: "TXFRAMEEND", 5: "RXFRAMESTART", 6: "RXFRAMEEND", 7: "ERROR", 19: "SELECTED", 20: "STARTED"}
+        print("  nrfx events at platform handler:", [n for b, n in bits.items() if ev >> b & 1], hex(ev))
+        print(f"  ACTIVATE forces: {words[0x61]}, deferred callbacks: {words[0x62]}, NFCTAGSTATE after force: {words[0x63]}, buffer alloc failures: {words[0x64]}")
+        print(f"  NFCT at first FIELD_OFF: ERRORSTATUS=0x{words[0x55]:X} SENSRES=0x{words[0x56]:X} SELRES=0x{words[0x57]:X} AUTOCOLRESCONFIG=0x{words[0x58]:X} NFCID1_LAST=0x{words[0x59]:X} INTEN=0x{words[0x5A]:X}")
+    if words[0x55] != 0xFFFFFFFF:
+        print(f"  IRQ counts at first FIELD_OFF: NFCT={words[0x65]} TIMER0={words[0x66]}")
+        print(f"  NVIC ISER0=0x{words[0x5B]:08X} (NFCT bit5={words[0x5B] >> 5 & 1}, TIMER0 bit8={words[0x5B] >> 8 & 1}) TIMER0 INTEN=0x{words[0x5C]:X} CC0={words[0x5D]} BITMODE={words[0x5E]} PRESCALER={words[0x5F]}")
+    print("  first TIMER0 IRQ:", "never" if words[0x70] == 0xFFFFFFFF else f"yes (EVENTS_COMPARE0={words[0x70] & 0xff})")
+    print("  first NFCT IRQ:", "never" if words[0x71] == 0xFFFFFFFF else "yes")
+    if words[0x72] != 0xFFFFFFFF:
+        print(f"  at FIELD_DETECTED: NVIC ISER0=0x{words[0x72]:08X} (NFCT={words[0x72] >> 5 & 1} TIMER0={words[0x72] >> 8 & 1}) TIMER0 INTEN=0x{words[0x73]:X} CC0={words[0x74]} PRESCALER={words[0x75]} SHORTS=0x{words[0x76]:X} IPR2=0x{words[0x77]:08X} PRIMASK={words[0x78] & 1}")
+    evn = ["FIELDDETECTED", "FIELDLOST", "AUTOCOLRESSTARTED", "COLLISION", "SELECTED", "RXFRAMESTART", "RXFRAMEEND", "RXERROR", "TXFRAMESTART", "ERROR"]
+    hw = [n for i, n in enumerate(evn) if words[0x80 + i] != 0xFFFFFFFF]
+    print("  NFCT hardware events seen:", hw or "none")
+    if words[0x87] != 0xFFFFFFFF:
+        print(f"    RXERROR FRAMESTATUS.RX=0x{words[0x87] & 0xffff:X} (bit0 CRC, bit2 parity, bit3 overrun)")
+    if words[0x89] != 0xFFFFFFFF:
+        print(f"    ERROR ERRORSTATUS=0x{words[0x89] & 0xffff:X} (bit0 FRAMEDELAYTIMEOUT, bit2 FIELD TOO STRONG, bit3 TOO WEAK)")
+    if words[0x8A] != 0xFFFFFFFF:
+        print(f"    at SELECTED: MAXLEN={words[0x8A]} PACKETPTR=0x{words[0x8B]:08X}")
+    if words[0x8C] != 0xFFFFFFFF:
+        print(f"    first RXFRAMEEND: RXD.AMOUNT=0x{words[0x8C]:X} (bytes={words[0x8C] >> 3 & 0x1ff}) first bytes={words[0x8D].to_bytes(4, 'little').hex() if words[0x8D] != 0xFFFFFFFF else '?'}")
+    if words[0x8E] != 0xFFFFFFFF:
+        print(f"    at RXERROR: MAXLEN={words[0x8E]} RXD.AMOUNT=0x{words[0x8F]:X}")
+    print("  first RTC2 flush-timer tick: ", "never" if words[0x90] == 0xFFFFFFFF else f"trace len then={words[0x90] & 0xffff}")
+    print("  first flush attempt: ", "never" if words[0x91] == 0xFFFFFFFF else f"trace len={words[0x91] & 0xffff}")
+    if words[0x92] != 0xFFFFFFFF:
+        print(f"  !!! INTERRUPT STORM: NFCT irqs={words[0x92] & 0xffff} NFCT.INTEN=0x{words[0x93]:X} TIMER0.INTEN=0x{words[0x94]:X} TIMER0.COMPARE0={words[0x95]} ICSR=0x{words[0x96]:08X} (VECTACTIVE={words[0x96] & 0x1ff}, VECTPENDING={(words[0x96] >> 12) & 0x1ff})")
+    hist = [words[0xC0 + k] for k in range(48) if words[0xC0 + k] != 0xFFFFFFFF]
+    if hist:
+        print("  per-second history (sec: trace_len nfct_irqs timer0_irqs tagstate fieldpresent):")
+        for k, h in enumerate(hist):
+            print(f"    {k:2d}s: len={h & 0xff} nfct={(h >> 8) & 0xfff} tmr0={(h >> 20) & 0xf} state={(h >> 24) & 7} field={(h >> 27) & 3}")
+    samples = [(k, words[0x340 + 4 * k: 0x344 + 4 * k]) for k in range(48) if words[0x340 + 4 * k] != 0xFFFFFFFF]
+    if samples:
+        print("  hang finder (sec: interrupted PC, active IRQs, SHCSR, VECTPENDING):")
+        for k, (h, pc, a0, a1) in samples:
+            print(f"    {k:2d}s: PC=0x{pc:08X} LR=0x{h:08X} IABR0=0x{a0:08X} IABR1=0x{a1 & 0xffff:04X} SHCSR=0x{(a1 >> 16) & 0xff:02X} VECTPENDING={a1 >> 24}")
+    print("  C-APDU complete in runner:", "never" if words[0xA5] == 0xFFFFFFFF else f"len={words[0xA5] & 0xffff}")
+    print("  applet read APDU:", "never" if words[0xA0] == 0xFFFFFFFF else f"len={words[0xA0] & 0xffff} head={words[0xA1]:08x}")
+    print("  applet sent R-APDU:", "never" if words[0xA2] == 0xFFFFFFFF else f"len={words[0xA2] & 0xffff} head={words[0xA3]:08x} send_result={(words[0xA4] & 0xffff) - (0x10000 if words[0xA4] & 0x8000 else 0)}")
+    if words[0xA6] != 0xFFFFFFFF and words[0xA8] != 0xFFFFFFFF:
+        print(f"  latency: APDU complete -> applet read = {((words[0xA8] - words[0xA6]) & 0xffffffff) / 64:.0f} us")
+    if words[0xA6] != 0xFFFFFFFF and words[0xA7] != 0xFFFFFFFF:
+        print(f"  latency: APDU complete -> response sent = {((words[0xA7] - words[0xA6]) & 0xffffffff) / 64:.0f} us")
+    if words[0x40] == 0xFA17FA17:
+        src = {1: "bootloader handler (fault before runner set VTOR)",
+               2: "runner HardFault", 0x9A41: "runner panic"}.get(words[0x41], hex(words[0x41]))
+        print(f"  FAULT from {src}: PC=0x{words[0x42]:08X} LR=0x{words[0x43]:08X} "
+              f"CFSR=0x{words[0x44]:08X} HFSR=0x{words[0x45]:08X} "
+              f"BFAR=0x{words[0x46]:08X} MMFAR=0x{words[0x47]:08X}")
+    else:
+        print("  no fault recorded")
+    print(f"LAST STAGE: {max(reached) if reached else 0}")
+
+
+if __name__ == "__main__":
+    main()
+
+
+def dump_trace(path):
+    """Prints the NFC trace (marker page words 0x100.., count at 0xFF)."""
+    import struct as st
+    data = open(path, "rb").read()
+    mem = {}
+    for i in range(len(data) // 512):
+        blk = data[i * 512:(i + 1) * 512]
+        addr, size = st.unpack("<II", blk[12:20])
+        mem[addr] = blk[32:32 + size]
+    page = b"".join(mem.get(MARKER_PAGE + off, b"\xee" * 256) for off in range(0, 0x1000, 256))
+    w = st.unpack("<1024I", page)
+    # Flight-recorder log: 0xE0000..0xE9000, 16-byte entries (erased entries = gaps).
+    logb = b"".join(mem.get(0xE0000 + off, b"\xff" * 256) for off in range(0, 0x9000, 256))
+    lw = st.unpack(f"<{len(logb) // 4}I", logb)
+    entries = [lw[4 * i: 4 * i + 4] for i in range(len(lw) // 4)]
+    last = max((i for i, e in enumerate(entries) if e[0] != 0xFFFFFFFF), default=-1)
+    if last < 0:
+        print("no NFC trace recorded")
+        return
+    if w[0x6E] != 0x10C:
+        print("NOTE: this log was written by an EARLIER boot (no NFC session since the last boot)")
+    names = {1: "IRQ>", 2: "IRQ<", 3: "rx()", 4: "rx=", 5: "tx()", 6: "tx=", 7: "plat", 8: "cbrq", 9: "app ", 10: "TMR0", 0xEE: "BOOT", 0xE1: "start", 0xE2: "stop", 0xF5: "FSD64", 0xF6: "rx-kept", 0xF7: "rx-copy"}
+    if w[0xFE] != 0xFFFFFFFF:
+        print(f"first flush: DIAG events=0x{w[0x60]:X} forces={w[0x61]} cbreq={w[0x62]} NFCT_irq={w[0x65]} TIMER0_irq={w[0x66]}")
+    ev = ["FDET", "FLOST", "ACRS", "COLL", "SEL", "RXS", "RXE", "RXERR", "TXS", "ERR", "TXE", "ENDRX", "ENDTX"]
+    t0 = None
+    print(f"NFC trace: {last + 1} entries")
+    gap = False
+    for i in range(last + 1):
+        tag, a, b, cyc = entries[i]
+        if tag == 0xFFFFFFFF:
+            if not gap:
+                print("  ... (entries lost: RAM ring overwritten) ...")
+            gap = True
+            continue
+        gap = False
+        t0 = cyc if t0 is None else t0
+        us = ((cyc - t0) & 0xFFFFFFFF) / 64
+        if tag == 1:
+            evs = [e for k, e in enumerate(ev) if a >> k & 1]
+            d = f"events={evs} FRAMESTATUS.RX=0x{a >> 16:X} MAXLEN={b & 0xffff} RXD.AMOUNT=0x{b >> 16:X}"
+        elif tag == 2:
+            d = f"MAXLEN={a} PACKETPTR=0x{b:X}"
+        elif tag == 3:
+            d = f"size={a} ptr=0x{b:08X}"
+        elif tag == 4:
+            d = f"ret={a - (1 << 32) if a >> 31 else a} MAXLEN={b}"
+        elif tag == 5:
+            d = f"size={a & 0xffffff} delay_mode={a >> 24} data={b.to_bytes(4, 'little').hex()}"
+        elif tag == 6:
+            d = f"ret={a - (1 << 32) if a >> 31 else a}"
+        elif tag == 7 and (a & 0xff) == 0x40:
+            d = f"RX_FRAMEEND rx_status=0x{(a >> 8) & 0xff:X} size={a >> 16} data={b.to_bytes(4, 'little').hex()}"
+        elif tag == 7:
+            d = f"nrfx evt=0x{a:X} HFCLKSTAT=0x{b:X}"
+        elif tag == 0xA6:
+            d = f"EMPTY I-block answered: send(0)={a - (1 << 32) if a >> 31 else a} send(9000)={b - (1 << 32) if b >> 31 else b}"
+        elif tag == 0xA5:
+            d = f"C-APDU  len={a} head={b:08x}"
+        elif tag == 0xA8:
+            d = f"   C-APDU bytes 4..11 = {a:08x}{b:08x}"
+        elif tag == 0xA7:
+            d = f"R-APDU  len={a} head={b:08x}"
+        elif tag == 0xA9:
+            d = f"   R-APDU SW={a:04X} send_result={b - (1 << 32) if b >> 31 else b}"
+        elif tag == 0xAA:
+            d = f"   C-DATA {a:08x}{b:08x}"
+        elif tag == 0xAB:
+            d = f"   R-DATA {a:08x}{b:08x}"
+        elif tag == 8:
+            d = f"ctx=0x{a:08X} data=0x{b:08X}"
+        elif tag == 9:
+            d = f"T4T event={a} len={b}"
+        elif tag == 10:
+            d = f"COMPARE0={a} NFCTAGSTATE={b}"
+        else:
+            d = f"{a:X} {b:X}"
+        print(f"  {us:10.1f} us  {names.get(tag, tag)}  {d}")
+
+
+if len(sys.argv) > 2 and sys.argv[2] == "--trace":
+    dump_trace(sys.argv[1])
