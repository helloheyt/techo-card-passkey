+# Registers a throw-away credential for rp "sigtest.invalid" over USB and verifies the
+# attestation and assertion signatures on the host (press button A when the LED asks).
+import os, time, hashlib
+from fido2.hid import CtapHidDevice
+from fido2.ctap2 import Ctap2
+from fido2.cose import CoseKey
+for _ in range(600):
+    devs = list(CtapHidDevice.list_devices())
+    if devs: break
+    time.sleep(1)
+ctap = Ctap2(devs[0])
+cdh = hashlib.sha256(b"client-data").digest()
+print("makeCredential: press button A now", flush=True)
+att = ctap.make_credential(cdh, {"id": "sigtest.invalid", "name": "sigtest"},
+                           {"id": os.urandom(16), "name": "t"}, [{"type": "public-key", "alg": -7}])
+print("fmt:", att.fmt)
+cred = att.auth_data.credential_data
+pub = CoseKey.parse(cred.public_key) if not isinstance(cred.public_key, CoseKey) else cred.public_key
+try:
+    from fido2.attestation import PackedAttestation
+    if att.fmt == "packed":
+        PackedAttestation().verify(att.att_stmt, att.auth_data, cdh)
+        print("attestation signature: OK")
+    else:
+        print("attestation fmt", att.fmt, "not checked")
+except Exception as e:
+    print("attestation signature: FAILED", type(e).__name__, e)
+print("getAssertion: press button A now", flush=True)
+a = ctap.get_assertion("sigtest.invalid", cdh, [{"type": "public-key", "id": cred.credential_id}])
+try:
+    pub.verify(bytes(a.auth_data) + cdh, a.signature)
+    print("assertion signature: OK")
+except Exception as e:
+    print("assertion signature: FAILED", type(e).__name__, e)
+print("sig hex:", a.signature.hex())
