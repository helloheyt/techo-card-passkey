+++ b/tools/usbalive.py
@@ -0,0 +1,15 @@
+import time, sys
+from fido2.hid import CtapHidDevice
+from fido2.ctap2 import Ctap2
+last = None
+end = time.time() + float(sys.argv[1] if len(sys.argv) > 1 else 900)
+while time.time() < end:
+    try:
+        d = list(CtapHidDevice.list_devices())
+        st = "alive" if d and Ctap2(d[0]).get_info() else "absent"
+    except Exception as e:
+        st = "error " + type(e).__name__
+    if st != last:
+        print(time.strftime("%T"), st, flush=True)
+        last = st
+    time.sleep(1)
