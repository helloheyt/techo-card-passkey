index 0000000..253df3f
--- /dev/null
+++ b/src/nfc.rs
@@ -0,0 +1,275 @@
+//! CTAP over NFC for the LilyGO T-Echo Card (FIDO CTAP 2.1, section 11.3).
+//!
+//! The platform (runner) exposes raw ISO 14443-4 APDUs through a vendor syscall. This module:
+//! - opens a short NFC window after the user presses button A (the platform reports the press),
+//!   keeping it open while a reader is in the field,
+//! - implements the APDU layer: SELECT of the FIDO AID, NFCCTAP_MSG, command chaining (CLA bit 4),
+//!   short and extended APDUs, and response chaining with `61 XX` + GET RESPONSE,
+//! - hands CTAP2 CBOR commands to OpenSK on `Channel::Nfc` (presence is implied by the tap).
+
+use alloc::vec::Vec;
+use core::sync::atomic::{AtomicBool, Ordering::Relaxed};
+
+use wasefire::debug;
+use wasefire::timer::Timeout;
+use wasefire::vendor::syscall;
+
+const SYSCALL_ID: usize = 0x8000_0002;
+const OP_REGISTER: usize = 1;
+const OP_START: usize = 3;
+const OP_STOP: usize = 4;
+const OP_READ: usize = 5;
+const OP_SEND: usize = 6;
+const OP_STATUS: usize = 7;
+
+const STATUS_FIELD: usize = 1 << 1;
+const STATUS_APDU: usize = 1 << 2;
+const STATUS_BUTTON: usize = 1 << 3;
+
+/// How long NFC stays enabled after pressing button A (without a reader in the field).
+const WINDOW_MS: usize = 30_000;
+/// Keep NFC on forever instead of a window after pressing A (debugging aid).
+const ALWAYS_ON: bool = false;
+/// Polling period while the window is open (only to notice its end; APDUs wake us via events).
+/// Kept long: every syscall runs critical sections that mask the NFCT interrupt.
+pub const POLL_MS: usize = 1000;
+
+const FIDO_AID: [u8; 8] = [0xA0, 0x00, 0x00, 0x06, 0x47, 0x2F, 0x00, 0x01];
+const SW_OK: [u8; 2] = [0x90, 0x00];
+const SW_WRONG_LENGTH: [u8; 2] = [0x67, 0x00];
+const SW_CONDITIONS: [u8; 2] = [0x69, 0x85];
+const SW_FILE_NOT_FOUND: [u8; 2] = [0x6A, 0x82];
+const SW_INS_NOT_SUPPORTED: [u8; 2] = [0x6D, 0x00];
+const SW_CLA_NOT_SUPPORTED: [u8; 2] = [0x6E, 0x00];
+
+/// Set by the platform event handler; checked by the USB receive loop so it returns early.
+static NOTIFIED: AtomicBool = AtomicBool::new(false);
+
+pub fn take_notified() -> bool {
+    NOTIFIED.swap(false, Relaxed)
+}
+
+pub fn is_notified() -> bool {
+    NOTIFIED.load(Relaxed)
+}
+
+extern "C" fn on_event(_data: *const u8) {
+    NOTIFIED.store(true, Relaxed);
+}
+
+pub struct Nfc {
+    window: Option<Timeout>,
+    selected: bool,
+    /// Data accumulated over chained C-APDUs (CLA bit 4).
+    chained: Vec<u8>,
+    /// Remaining response bytes for GET RESPONSE.
+    pending: Vec<u8>,
+    buffer: Vec<u8>,
+}
+
+impl Nfc {
+    pub fn new() -> Option<Self> {
+        let func = on_event as extern "C" fn(*const u8);
+        // Safety: the handler is a plain function without data.
+        unsafe { syscall(SYSCALL_ID, OP_REGISTER, func as usize, 0) }.ok()?;
+        let mut nfc = Nfc {
+            window: None,
+            selected: false,
+            chained: Vec::new(),
+            pending: Vec::new(),
+            buffer: alloc::vec![0; 4096],
+        };
+        // NFC stays off until button A is pressed (see `service`).
+        if ALWAYS_ON {
+            nfc.open_window();
+        }
+        Some(nfc)
+    }
+
+    /// Whether the NFC window is open (the main loop should then poll every [`POLL_MS`]).
+    pub fn is_active(&self) -> bool {
+        self.window.is_some()
+    }
+
+    fn status() -> usize {
+        unsafe { syscall(SYSCALL_ID, OP_STATUS, 0, 0) }.unwrap_or(0)
+    }
+
+    fn open_window(&mut self) {
+        if self.window.is_none() {
+            let _ = unsafe { syscall(SYSCALL_ID, OP_START, 0, 0) };
+            debug!("NFC window opened");
+        }
+        self.window = Some(Timeout::new_ms(WINDOW_MS));
+    }
+
+    fn close_window(&mut self) {
+        let _ = unsafe { syscall(SYSCALL_ID, OP_STOP, 0, 0) };
+        self.window = None;
+        self.reset_session();
+        debug!("NFC window closed");
+    }
+
+    fn reset_session(&mut self) {
+        self.selected = false;
+        self.chained.clear();
+        self.pending.clear();
+    }
+
+    /// Services NFC: button presses, incoming APDUs and the window timeout.
+    pub fn service<E: opensk::env::Env>(&mut self, ctap: &mut opensk::Ctap<E>) {
+        let status = Self::status();
+        if status & STATUS_BUTTON != 0 {
+            self.open_window();
+        }
+        if self.window.is_none() {
+            return;
+        }
+        if status & STATUS_FIELD != 0 {
+            // Keep the window open while a reader is talking to us (never shorten it).
+            if self.window.as_ref().is_some_and(Timeout::is_over) {
+                self.window = Some(Timeout::new_ms(WINDOW_MS));
+            }
+        } else {
+            self.reset_session();
+        }
+        if status & STATUS_APDU != 0 {
+            let len = unsafe {
+                syscall(SYSCALL_ID, OP_READ, self.buffer.as_mut_ptr() as usize, self.buffer.len())
+            }
+            .unwrap_or(0);
+            if len > 0 {
+                let apdu = self.buffer[.. len].to_vec();
+                let response = self.process(ctap, &apdu);
+                let _ = unsafe {
+                    syscall(SYSCALL_ID, OP_SEND, response.as_ptr() as usize, response.len())
+                };
+            }
+        }
+        if self.window.as_ref().is_some_and(Timeout::is_over) {
+            if ALWAYS_ON {
+                self.window = Some(Timeout::new_ms(WINDOW_MS));
+            } else {
+                self.close_window();
+            }
+        }
+    }
+
+    fn process<E: opensk::env::Env>(&mut self, ctap: &mut opensk::Ctap<E>, apdu: &[u8]) -> Vec<u8> {
+        let Some(cmd) = Apdu::parse(apdu) else {
+            return SW_WRONG_LENGTH.to_vec();
+        };
+        let cla = cmd.cla & !0x10;
+        // GET RESPONSE (ISO 7816-4), continuing a chained response.
+        if cmd.ins == 0xC0 && cla == 0x00 {
+            return self.next_chunk(cmd.le);
+        }
+        match (cla, cmd.ins) {
+            (0x00, 0xA4) => {
+                self.reset_session();
+                if cmd.p1 == 0x04 && cmd.data == FIDO_AID {
+                    self.selected = true;
+                    // CTAP2-only over NFC (no U2F over NFC): advertise FIDO_2_0.
+                    let mut response = b"FIDO_2_0".to_vec();
+                    response.extend_from_slice(&SW_OK);
+                    response
+                } else {
+                    SW_FILE_NOT_FOUND.to_vec()
+                }
+            }
+            (0x80, 0x10) => {
+                if !self.selected {
+                    return SW_CONDITIONS.to_vec();
+                }
+                self.chained.extend_from_slice(cmd.data);
+                if cmd.cla & 0x10 != 0 {
+                    return SW_OK.to_vec(); // more chained data follows
+                }
+                let request = core::mem::take(&mut self.chained);
+                let mut response = ctap.process_nfc_command(&request);
+                if response == [0x00] {
+                    // Success without data (e.g. clientPin setPIN): Google Play Services decodes the
+                    // bytes after the status as CBOR even then and fails on what follows ("90 00"
+                    // read as array(16)); an explicit empty map keeps it happy and other platforms
+                    // ignore it.
+                    response.push(0xA0);
+                }
+                self.pending = response;
+                if cmd.extended {
+                    // Extended APDU: the platform expects the whole response in one R-APDU
+                    // (Google Play Services' FIDO stack does not follow 61 XX here); the ISO-DEP
+                    // layer chains the I-blocks itself.
+                    let mut full = core::mem::take(&mut self.pending);
+                    full.extend_from_slice(&SW_OK);
+                    full
+                } else {
+                    // Short APDU: chain with 61 XX + GET RESPONSE.
+                    self.next_chunk(cmd.le)
+                }
+            }
+            (0x80, 0x11) => SW_CONDITIONS.to_vec(), // NFCCTAP_GETRESPONSE: we answer synchronously
+            (0x00 | 0x80, _) => SW_INS_NOT_SUPPORTED.to_vec(),
+            _ => SW_CLA_NOT_SUPPORTED.to_vec(),
+        }
+    }
+
+    /// Returns the next chunk of the pending response with `61 XX` or `90 00`.
+    fn next_chunk(&mut self, le: usize) -> Vec<u8> {
+        // At most 250 bytes per R-APDU: the Type 4 Tag library is reported to lose bytes when it
+        // has to fragment longer responses (solo2 nrf52840 runner).
+        let max = if le == 0 { 250 } else { le.min(250) };
+        let take = self.pending.len().min(max);
+        let mut response: Vec<u8> = self.pending.drain(.. take).collect();
+        match self.pending.len() {
+            0 => response.extend_from_slice(&SW_OK),
+            n => response.extend_from_slice(&[0x61, n.min(0xFF) as u8]),
+        }
+        response
+    }
+}
+
+struct Apdu<'a> {
+    cla: u8,
+    ins: u8,
+    p1: u8,
+    data: &'a [u8],
+    le: usize,
+    extended: bool,
+}
+
+impl<'a> Apdu<'a> {
+    /// Parses a short or extended ISO 7816-4 command APDU (cases 1 to 4).
+    fn parse(apdu: &'a [u8]) -> Option<Self> {
+        let (cla, ins, p1, _p2) = (*apdu.first()?, *apdu.get(1)?, *apdu.get(2)?, *apdu.get(3)?);
+        let body = &apdu[4 ..];
+        let mut cmd = Apdu { cla, ins, p1, data: &[], le: 0, extended: false };
+        match body.len() {
+            0 => (),
+            1 => cmd.le = body[0] as usize,
+            _ if body[0] != 0 => {
+                let lc = body[0] as usize;
+                cmd.data = body.get(1 .. 1 + lc)?;
+                match body.len() - 1 - lc {
+                    0 => (),
+                    1 => cmd.le = body[1 + lc] as usize,
+                    _ => return None,
+                }
+            }
+            3 => {
+                cmd.extended = true;
+                cmd.le = u16::from_be_bytes([body[1], body[2]]) as usize;
+            }
+            _ => {
+                cmd.extended = true;
+                let lc = u16::from_be_bytes([*body.get(1)?, *body.get(2)?]) as usize;
+                cmd.data = body.get(3 .. 3 + lc)?;
+                match body.len() - 3 - lc {
+                    0 => (),
+                    2 => cmd.le = u16::from_be_bytes([body[3 + lc], body[4 + lc]]) as usize,
+                    _ => return None,
+                }
+            }
+        }
+        Some(cmd)
+    }
+}
