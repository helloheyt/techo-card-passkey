+import time
+from fido2.hid import CtapHidDevice
+from fido2.ctap2 import Ctap2
+from fido2.ctap2.pin import ClientPin, PinProtocolV2
+for _ in range(600):
+    devs = list(CtapHidDevice.list_devices())
+    if devs: break
+    time.sleep(1)
+if not devs:
+    print("no FIDO device over USB"); raise SystemExit
+ctap = Ctap2(devs[0])
+t = time.time(); info = ctap.get_info(); print("getInfo ok, clientPin =", info.options.get("clientPin"), f"{(time.time()-t)*1000:.0f} ms")
+cp = ClientPin(ctap, PinProtocolV2())
+t = time.time(); ka = cp._get_shared_secret(); print(f"getKeyAgreement + ECDH ok in {(time.time()-t)*1000:.0f} ms")
+for i in range(3):
+    t = time.time(); cp._get_shared_secret(); print(f"getKeyAgreement + ECDH #{i+2}: {(time.time()-t)*1000:.0f} ms")
