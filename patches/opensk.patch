+++ b/tools/techo_apdus.py
@@ -0,0 +1,34 @@
+"""Rebuilds full C-/R-APDUs from a techo_markers --trace output and decodes CTAP2 CBOR."""
+import sys, re
+lines = open(sys.argv[1]).read().splitlines()
+apdus = []
+cur = None
+for l in lines:
+    m = re.search(r"(C|R)-APDU  len=(\d+) head=([0-9a-f]{8})", l)
+    if m:
+        cur = [m.group(1), int(m.group(2)), bytearray.fromhex(m.group(3))]
+        apdus.append(cur)
+        continue
+    m = re.search(r"C-APDU bytes 4..11 = ([0-9a-f]{16})", l)
+    if m and cur and cur[0] == "C":
+        cur[2] += bytes.fromhex(m.group(1)); continue
+    m = re.search(r"(C|R)-DATA ([0-9a-f]{16})", l)
+    if m and cur and cur[0] == m.group(1):
+        cur[2] += bytes.fromhex(m.group(2))
+for kind, n, data in apdus:
+    data = bytes(data[:n])
+    print(f"{kind} len={n}: {data.hex()}")
+    try:
+        import cbor2
+        if kind == "C" and data[:2] == b"\x80\x10":
+            if data[4] == 0:
+                body = data[7:7 + int.from_bytes(data[5:7], "big")]
+            else:
+                body = data[5:5 + data[4]]
+            print("   cmd", hex(body[0]), cbor2.loads(body[1:]) if len(body) > 1 else "")
+        if kind == "R" and n > 3 and data[0] == 0:
+            print("   ", cbor2.loads(data[1:-2]))
+        elif kind == "R" and n == 3:
+            print("    CTAP status", hex(data[0]))
+    except Exception as e:
+        print("   (decode:", type(e).__name__, e, ")")
