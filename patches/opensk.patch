--- /dev/null
+++ b/tools/techo_uf2.py
@@ -0,0 +1,96 @@
+#!/usr/bin/env python3
+"""Convert Wasefire/OpenSK platform.hex into a UF2 for the LilyGO T-Echo Card.
+
+The T-Echo Card ships with the Adafruit nRF52 UF2 bootloader (top of flash) and
+a SoftDevice at 0x1000..0x27000. OpenSK/Wasefire replaces the SoftDevice region
+with its own bootloader (0x1000) and runner (0x8000). Any page of the old
+SoftDevice left untouched (e.g. its magic word at 0x3000) would make the UF2
+bootloader think a SoftDevice is still present and jump into garbage, so we
+pad every gap in 0x1000..0xE0000 with 0xFF (also clears leftovers of the
+previous application in the runner/applet/store regions).
+
+Safety: refuses to emit data below 0x1000 (MBR) or at/above 0xE0000
+(UF2 bootloader + its settings), so the bootloader stays recoverable.
+
+The OpenSK store (0xDA000..0xE0000: passkeys, PIN) is left untouched unless --wipe-store.
+
+Usage: techo_uf2.py [--wipe-store] <platform.hex> <out.uf2>
+"""
+import struct
+import sys
+
+FAMILY_NRF52840 = 0xADA52840
+LOW, HIGH = 0x1000, 0xE0000
+SD_END = 0x27000
+# Diagnostics marker page (see runner-nordic/src/techo_debug.rs). Inside the UF2
+# bootloader's app space (< 0xEA000 on nRF52840) but outside the Wasefire layout (< 0xE0000).
+MARKER_PAGE, MARKER_END = 0xE9000, 0xEA000
+BLOCK = 256
+# OpenSK persistent store (credentials, PIN, master keys): never written by default, so a
+# firmware update keeps the user's passkeys. Pass --wipe-store to erase it on purpose.
+STORE, STORE_END = 0xDA000, 0xE0000
+
+
+def read_hex(path):
+    mem, base = {}, 0
+    with open(path) as f:
+        for line in f:
+            line = line.strip()
+            if not line.startswith(":"):
+                continue
+            raw = bytes.fromhex(line[1:])
+            if sum(raw) & 0xFF:
+                sys.exit(f"bad checksum: {line}")
+            n, addr, typ = raw[0], (raw[1] << 8) | raw[2], raw[3]
+            data = raw[4:4 + n]
+            if typ == 0:
+                for i, b in enumerate(data):
+                    mem[base + addr + i] = b
+            elif typ == 1:
+                break
+            elif typ == 2:
+                base = int.from_bytes(data, "big") << 4
+            elif typ == 4:
+                base = int.from_bytes(data, "big") << 16
+    return mem
+
+
+def main():
+    args = [a for a in sys.argv[1:] if a != "--wipe-store"]
+    wipe_store = "--wipe-store" in sys.argv[1:]
+    if len(args) != 2:
+        sys.exit(__doc__)
+    sys.argv[1:] = args
+    mem = read_hex(sys.argv[1])
+    if not mem:
+        sys.exit("empty hex")
+    lo, hi = min(mem), max(mem)
+    if lo < LOW or hi >= HIGH:
+        sys.exit(f"refusing: data spans 0x{lo:X}..0x{hi:X}, allowed 0x{LOW:X}..0x{HIGH:X}")
+    # Wipe every gap up to HIGH so no stale code from the previous firmware
+    # (SoftDevice, factory/Meshtastic app) is left in the runner, applet or
+    # store regions.
+    for a in range(LOW, HIGH):
+        mem.setdefault(a, 0xFF)
+    for a in range(MARKER_PAGE, MARKER_END):
+        mem[a] = 0xFF
+    if not wipe_store:
+        if any(STORE <= a < STORE_END and mem[a] != 0xFF for a in range(STORE, STORE_END)):
+            sys.exit("refusing: the image has data in the store region")
+        for a in range(STORE, STORE_END):
+            del mem[a]
+    pages = sorted({a & ~(BLOCK - 1) for a in mem})
+    blocks = []
+    for i, page in enumerate(pages):
+        payload = bytes(mem.get(page + j, 0xFF) for j in range(BLOCK))
+        hdr = struct.pack("<IIIIIIII", 0x0A324655, 0x9E5D5157, 0x2000, page, BLOCK, i,
+                          len(pages), FAMILY_NRF52840)
+        blk = hdr + payload + b"\x00" * (512 - 32 - BLOCK - 4) + struct.pack("<I", 0x0AB16F30)
+        blocks.append(blk)
+    with open(sys.argv[2], "wb") as f:
+        f.write(b"".join(blocks))
+    print(f"wrote {sys.argv[2]}: {len(blocks)} blocks, 0x{pages[0]:X}..0x{pages[-1] + BLOCK:X}")
+
+
+if __name__ == "__main__":
+    main()
